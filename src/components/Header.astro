---
interface Props {
  logo?: string;
  navLinks?: Array<{ href: string; text: string }>;
  rightNavLinks?: Array<{ href: string; text: string }>;
  currentPath?: string;
}

const {
  logo = "Plateforme des Mystères",
  navLinks = [
    { href: "/blog/", text: "Blog" },
    { href: "/#portails", text: "Disciplines" },
    { href: "/boutique/", text: "Boutique" },
    { href: "/rapport/", text: "Votre Rapport Personnalisé" },
  ],
  rightNavLinks = [
    { href: "/a-propos/", text: "À propos" }
  ],
  currentPath = ""
} = Astro.props;

function isActive(linkHref: string, path: string): boolean {
  if (!path) return false;
  const clean = path.replace(/^\/|\/$/g, '').split('#')[0];
  const linkClean = linkHref.replace(/^\/|\/$/g, '').split('#')[0];
  if (linkClean === '' && clean === '') return true;
  if (linkClean === 'blog' && clean.startsWith('blog')) return true;
  if (linkClean === 'a-propos' && clean === 'a-propos') return true;
  if (linkClean === '#portails' && (clean.startsWith('numerologie') || clean.startsWith('tarologie') || clean.startsWith('astrologie') || clean.startsWith('oracles'))) return true;
  if (linkClean === 'rapport' && clean === 'rapport') return true;
  return false;
}
---
<header>
  <div class="header-container">
    <div class="header-left">
      <a href="/" class="logo">
        <span class="symbol">◈</span>
        <span class="text">{logo}</span>
      </a>
      <nav id="mainNav">
        {navLinks.map(({ href, text }) => (
          <a href={href} class={isActive(href, currentPath) ? 'active' : ''}>{text}</a>
        ))}
      </nav>
    </div>
    <div class="header-right">
      <nav id="secondaryNav">
        {rightNavLinks.map(({ href, text }) => (
          <a href={href} class={isActive(href, currentPath) ? 'active' : ''}>{text}</a>
        ))}
      </nav>
      <button id="themeToggle" type="button" class="theme-btn" aria-label="Changer le thème">🌙</button>
      <button
        id="menuToggle"
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mainNav secondaryNav"
        aria-label="Ouvrir le menu"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  header nav a[href="/rapport/"] {
    color: var(--gold-text) !important;
    border: 1px solid rgba(223,178,108,0.3);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  header nav a[href="/rapport/"]:hover,
  header nav a[href="/rapport/"].active {
    background: rgba(223,178,108,0.1);
    border-color: rgba(223,178,108,0.55);
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const headerEl = menuToggle?.closest('header');
  const menuToggleIcon = menuToggle?.querySelector('span');

  function closeMobileMenu() {
    if (!headerEl || !menuToggle) return;
    headerEl.classList.remove('nav-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Ouvrir le menu');
    if (menuToggleIcon) menuToggleIcon.textContent = '☰';
  }

  function openMobileMenu() {
    if (!headerEl || !menuToggle) return;
    headerEl.classList.add('nav-open');
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', 'Fermer le menu');
    if (menuToggleIcon) menuToggleIcon.textContent = '✕';
  }

  if (headerEl && menuToggle) {
    menuToggle.addEventListener('click', () => {
      if (headerEl.classList.contains('nav-open')) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && headerEl.classList.contains('nav-open')) {
        closeMobileMenu();
        menuToggle.focus();
      }
    });

    // Sécurité : si le viewport repasse en desktop pendant que le menu est
    // ouvert, on réinitialise l'état (les règles CSS sont de toute façon
    // scopées à @media (max-width: 768px), donc ceci n'affecte jamais le
    // rendu desktop, seulement la cohérence de l'état ARIA).
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && headerEl.classList.contains('nav-open')) {
        closeMobileMenu();
      }
    });
  }
</script>
