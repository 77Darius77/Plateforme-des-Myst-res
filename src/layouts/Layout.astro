---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: Record<string, any>;
  noJsonLd?: boolean;
  useBlogStyles?: boolean;
  scripts?: string[];
  headerLogo?: string;
  headerNavLinks?: Array<{ href: string; text: string }>;
  footerSources?: string;
  section?: 'numerologie' | 'tarologie' | 'astrologie' | 'oracles' | 'blog';
  breadcrumb?: Array<{ name: string; item: string }>;
  ogImage?: string;
}

const {
  title,
  description,
  keywords = "ésotérisme, numérologie, astrologie, tarologie, oracles",
  canonicalPath = "",
  ogTitle,
  ogDescription,
  jsonLd,
  noJsonLd = false,
  useBlogStyles = false,
  scripts = [],
  headerLogo,
  headerNavLinks,
  footerSources,
  section,
  breadcrumb,
  ogImage
} = Astro.props;

function normalizeCanonicalPath(p: string): string {
  if (p === '' || p === 'index.html') return '';
  if (p.endsWith('/index.html')) return p.slice(0, -'index.html'.length);
  if (p.endsWith('.html')) return p.slice(0, -5) + '/';
  return p.endsWith('/') ? p : p + '/';
}
const canonicalUrl = `https://plateforme-des-mysteres.com/${normalizeCanonicalPath(canonicalPath)}`;
const finalOgTitle = ogTitle || title;
const finalOgDescription = ogDescription || description;
const finalOgImage = ogImage || 'https://plateforme-des-mysteres.com/images/og-default.svg';

// Schema par défaut pour les pages-outils (tirages, calculateurs) qui ne
// fournissent pas leur propre jsonLd — évite d'avoir des dizaines de pages
// sans aucune donnée structurée.
const defaultJsonLd = (!jsonLd && !noJsonLd) ? {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": finalOgTitle,
  "description": finalOgDescription,
  "url": canonicalUrl,
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Any",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
} : null;
---
<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="48JTjdd6R-QJi1x9oSUhnnasxuOnMlVvnVAvWeq1i20">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Plateforme des Mystères">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:title" content={finalOgTitle}>
  <meta property="og:description" content={finalOgDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="fr_FR">
  <meta property="og:image" content={finalOgImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Plateforme des Mystères">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={finalOgTitle}>
  <meta name="twitter:description" content={finalOgDescription}>
  <meta name="twitter:image" content={finalOgImage}>

  <!-- Schema.org JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  {defaultJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(defaultJsonLd)} />
  )}

  <!-- BreadcrumbList JSON-LD -->
  {breadcrumb && breadcrumb.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumb.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.item
      }))
    })} />
  )}

  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/images/favicon.svg">
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;600&display=swap"></noscript>
  
  <!-- Central Stylesheets -->
  <link rel="stylesheet" href="/assets/css/design-system.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/layout-specific.css">
  {useBlogStyles && <link rel="stylesheet" href="/assets/css/blog.css">}

  <!-- Inline script to prevent FOUC (Flash of Unstyled Content) -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body data-section={section}>

  <!-- Reading Progress Bar (blog articles) -->
  {useBlogStyles && <div class="reading-progress"></div>}

  <!-- Skip Link (A11y) -->
  <a href="#content" class="skip-link">Aller au contenu principal</a>

  <!-- JavaScript Fallback -->
  <noscript>
    <div style="background:#0f172a;color:#fbbf24;text-align:center;padding:2rem;font-family:system-ui;">
      <p>⚠️ Certaines fonctionnalités interactives nécessitent JavaScript.</p>
    </div>
  </noscript>

  <!-- Header Component -->
  <Header logo={headerLogo} navLinks={headerNavLinks} currentPath={canonicalPath} />

  <!-- Main Content Wrapper -->
  <main id="content">
    <slot />
    {useBlogStyles && (
      <div style="max-width:720px;margin:0 auto 3rem;padding:0 1.5rem;text-align:center;">
        <button class="share-btn" type="button">🔗 Partager cet article</button>
      </div>
    )}
  </main>

  <!-- Footer Component -->
  <Footer sources={footerSources} />

  <!-- Global Toast -->
  <div class="toast" id="toast"></div>

  <!-- Global JavaScript -->
  <script is:inline src="/assets/js/main.js"></script>

  <!-- Page-Specific JavaScripts -->
  {scripts.map(src => (
    <script is:inline src={src}></script>
  ))}

  <!-- Scroll to Top Button -->
  <button onclick="window.scrollTo({top:0,behavior:'smooth'})" id="scrollTopBtn" style="position:fixed;bottom:2rem;right:2rem;background:#1e293b;color:#fbbf24;border:1px solid #334155;border-radius:50%;width:44px;height:44px;cursor:pointer;font-size:1.2rem;z-index:100;opacity:0;transition:opacity 0.3s;pointer-events:none;" aria-label="Retour en haut de page">↑</button>

</body>
</html>
