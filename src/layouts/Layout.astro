---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: Record<string, any>;
  useBlogStyles?: boolean;
  scripts?: string[];
  headerLogo?: string;
  headerNavLinks?: Array<{ href: string; text: string }>;
  footerSources?: string;
}

const {
  title,
  description,
  keywords = "ésotérisme, numérologie, astrologie, tarologie, oracles",
  canonicalPath = "",
  ogTitle,
  ogDescription,
  jsonLd,
  useBlogStyles = false,
  scripts = [],
  headerLogo,
  headerNavLinks,
  footerSources
} = Astro.props;

const canonicalUrl = `https://mysteres.fr/${canonicalPath}`;
const finalOgTitle = ogTitle || title;
const finalOgDescription = ogDescription || description;
---
<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Plateforme des Mystères">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:title" content={finalOgTitle}>
  <meta property="og:description" content={finalOgDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="fr_FR">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={finalOgTitle}>
  <meta name="twitter:description" content={finalOgDescription}>

  <!-- Schema.org JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  
  <!-- Central Stylesheets -->
  <link rel="stylesheet" href="/assets/css/design-system.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  {useBlogStyles && <link rel="stylesheet" href="/assets/css/blog.css">}

  <!-- Inline script to prevent FOUC (Flash of Unstyled Content) -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <!-- Skip Link (A11y) -->
  <a href="#content" class="skip-link">Aller au contenu principal</a>

  <!-- JavaScript Fallback -->
  <noscript>
    <div style="background:#0f172a;color:#fbbf24;text-align:center;padding:2rem;font-family:system-ui;">
      <p>⚠️ Certaines fonctionnalités interactives nécessitent JavaScript.</p>
    </div>
  </noscript>

  <!-- Header Component -->
  <Header logo={headerLogo} navLinks={headerNavLinks} currentPath={canonicalPath} />

  <!-- Main Content Wrapper -->
  <main id="content">
    <slot />
  </main>

  <!-- Footer Component -->
  <Footer sources={footerSources} />

  <!-- Global Toast -->
  <div class="toast" id="toast"></div>

  <!-- Global JavaScript -->
  <script is:inline src="/assets/js/main.js"></script>

  <!-- Page-Specific JavaScripts -->
  {scripts.map(src => (
    <script is:inline src={src}></script>
  ))}

  <!-- Scroll to Top Button -->
  <button onclick="window.scrollTo({top:0,behavior:'smooth'})" id="scrollTopBtn" style="position:fixed;bottom:2rem;right:2rem;background:#1e293b;color:#fbbf24;border:1px solid #334155;border-radius:50%;width:44px;height:44px;cursor:pointer;font-size:1.2rem;z-index:100;opacity:0;transition:opacity 0.3s;pointer-events:none;" aria-label="Retour en haut de page">↑</button>

</body>
</html>
