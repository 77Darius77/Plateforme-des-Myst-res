---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Astrologie Sidérale — Calculateur d'Ayanamsa de Lahiri & Thème Natal",
  "url": "https://plateforme-des-mysteres.com/astrologie/siderale/",
  "description": "Découvrez l'astrologie sidérale : calculez votre signe solaire et votre ascendant sidéraux réels grâce à l'ayanamsa de Lahiri. Explorez les 12 constellations et les bases de l'astrologie stellaire.",
  "inLanguage": "fr",
  "about": { "@type": "Thing", "name": "Astrologie Sidérale" }
};
---

<Layout
  title="Astrologie Sidérale — Calculateur Ayanamsa de Lahiri · Thème Stellaire"
  description="Calculez votre signe et votre ascendant sidéraux réels avec la correction de l'Ayanamsa de Lahiri. Explorez l'astrologie stellaire et les constellations."
  keywords="astrologie sidérale, ayanamsa lahiri, zodiaque sidéral, constellations réelles, jyotish, thème stellaire, ascendant sidéral"
  canonicalPath="astrologie/siderale/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Astrologie", item: "https://plateforme-des-mysteres.com/astrologie/" },
    { name: "Astrologie Sidérale", item: "https://plateforme-des-mysteres.com/astrologie/siderale/" }
  ]}
  section="astrologie"
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/astrologie/" style="color:var(--cyan);">Astrologie</a> &rsaquo;
  <span style="color:var(--text);">Astrologie Sidérale</span>
</nav>

<!-- ═══════════ HERO ═══════════ -->
<section id="hero">
  <h1>
    <span class="pulse"></span>
    Le zodiaque des<br><span class="emerald">étoiles fixes</span>
  </h1>
  <p class="subtitle">
    L'astrologie sidérale s'aligne sur les <strong>constellations réelles</strong> observées dans la voûte céleste. Pour corriger la dérive due à la précession des équinoxes (environ 1° tous les 72 ans), elle applique un décalage appelé <strong>Ayanamsa</strong> (le système de Lahiri étant la référence officielle). Cette approche, pilier du <strong>Jyotish</strong> (astrologie védique), décale la majorité des thèmes d'environ 24° en arrière par rapport au zodiaque tropical traditionnel, révélant la position exacte de votre âme face aux étoiles fixes au moment de votre naissance.
  </p>
  <a href="#calculateur" class="cta" style="background:var(--emerald);color:#0f172a;box-shadow:0 0 20px rgba(61,211,153,0.35);">✦ Calculer mon thème sidéral</a>
  <p class="quote">
    « Les étoiles ne forcent pas le destin, mais elles marquent l'instant où l'esprit s'incarne dans la matière. »
    <br><span class="emerald">— Sagesse Védique Ancienne</span>
  </p>
</section>

<!-- ═══════════ [01] CALCULATEUR ═══════════ -->
<section id="calculateur">
  <div class="section-title">
    <div class="num" style="color:var(--emerald);border-color:rgba(61,211,153,0.3);">[ 01 ]</div>
    <h2>✦ Calculateur Sidéral (Lahiri)</h2>
    <p class="slate">Entrez vos données de naissance pour calculer vos coordonnées sidérales réelles et appliquer la correction d'Ayanamsa.</p>
  </div>

  <form class="pyth-form" id="at-form" data-prevent-submit>
    <div class="pyth-form-group">
      <label class="pyth-label">Date de naissance</label>
      <div class="pyth-date-row">
        <div class="pyth-field">
          <input type="number" id="at-jour" class="pyth-input" min="1" max="31" placeholder="JJ" aria-label="Jour" inputmode="numeric">
          <span class="pyth-field-label">Jour</span>
        </div>
        <div class="pyth-field">
          <input type="number" id="at-mois" class="pyth-input" min="1" max="12" placeholder="MM" aria-label="Mois" inputmode="numeric">
          <span class="pyth-field-label">Mois</span>
        </div>
        <div class="pyth-field pyth-field--wide">
          <input type="number" id="at-annee" class="pyth-input" min="1900" max="2100" placeholder="AAAA" aria-label="Année" inputmode="numeric">
          <span class="pyth-field-label">Année</span>
        </div>
      </div>
    </div>

    <div class="pyth-form-group">
      <label class="pyth-label">Heure de naissance <span style="color:var(--text-muted);font-size:0.8rem;">(nécessaire pour l'ascendant)</span></label>
      <div class="pyth-date-row">
        <div class="pyth-field">
          <input type="number" id="at-heure" class="pyth-input" min="0" max="23" placeholder="HH" aria-label="Heure" inputmode="numeric">
          <span class="pyth-field-label">Heure</span>
        </div>
        <div class="pyth-field">
          <input type="number" id="at-minute" class="pyth-input" min="0" max="59" placeholder="MM" aria-label="Minute" inputmode="numeric">
          <span class="pyth-field-label">Minute</span>
        </div>
      </div>
    </div>

    <div class="pyth-form-group">
      <label class="pyth-label">Lieu de naissance</label>
      <div class="at-select-wrap">
        <select id="at-ville" class="at-select-native" aria-label="Ville de naissance" style="border-color:rgba(61,211,153,0.3);">
          <option value="">-- Choisir une ville --</option>
          <optgroup label="🇫🇷 France">
            <option value="48.8566|2.3522|eu|1">Paris</option>
            <option value="45.7640|4.8357|eu|1">Lyon</option>
            <option value="43.2965|5.3698|eu|1">Marseille</option>
            <option value="43.6047|1.4442|eu|1">Toulouse</option>
            <option value="44.8378|-0.5792|eu|1">Bordeaux</option>
            <option value="47.2184|-1.5536|eu|1">Nantes</option>
            <option value="48.5734|7.7521|eu|1">Strasbourg</option>
            <option value="50.6292|3.0573|eu|1">Lille</option>
            <option value="43.7102|7.2620|eu|1">Nice</option>
            <option value="48.1173|-1.6778|eu|1">Rennes</option>
            <option value="45.1885|5.7245|eu|1">Grenoble</option>
            <option value="43.6119|3.8772|eu|1">Montpellier</option>
          </optgroup>
          <optgroup label="🇧🇪🇨🇭 Belgique · Suisse · Luxembourg">
            <option value="50.8503|4.3517|eu|1">Bruxelles</option>
            <option value="46.2044|6.1432|eu|1">Genève</option>
            <option value="46.5197|6.6323|eu|1">Lausanne</option>
            <option value="47.3769|8.5417|eu|1">Zürich</option>
            <option value="49.6117|6.1319|eu|1">Luxembourg</option>
          </optgroup>
          <optgroup label="🇬🇧🇵🇹 Royaume-Uni · Portugal">
            <option value="51.5074|-0.1278|uk|0">Londres</option>
            <option value="38.7223|-9.1393|uk|0">Lisbonne</option>
          </optgroup>
          <optgroup label="🇪🇸🇮🇹🇩🇪 Europe Sud · Est">
            <option value="40.4168|-3.7038|eu|1">Madrid</option>
            <option value="41.3851|2.1734|eu|1">Barcelone</option>
            <option value="41.9028|12.4964|eu|1">Rome</option>
            <option value="52.5200|13.4050|eu|1">Berlin</option>
          </optgroup>
          <optgroup label="🌍 Maghreb">
            <option value="33.5731|-7.5898|none|1">Casablanca</option>
            <option value="34.0209|-6.8416|none|1">Rabat</option>
            <option value="36.7372|3.0865|none|1">Alger</option>
            <option value="36.8065|10.1815|none|1">Tunis</option>
          </optgroup>
          <optgroup label="🌍 Afrique subsaharienne">
            <option value="14.7167|-17.4677|none|0">Dakar</option>
            <option value="5.3600|-4.0083|none|0">Abidjan</option>
            <option value="3.8480|11.5021|none|1">Yaoundé</option>
          </optgroup>
          <optgroup label="🌊 DOM-TOM">
            <option value="14.6415|-61.0242|none|-4">Martinique</option>
            <option value="16.2650|-61.5510|none|-4">Guadeloupe</option>
            <option value="-20.8789|55.4481|none|4">La Réunion</option>
            <option value="-22.2758|166.4580|none|11">Nouvelle-Calédonie</option>
            <option value="-17.5516|-149.5585|none|-10">Polynésie française</option>
          </optgroup>
          <optgroup label="🌎 Amérique du Nord">
            <option value="45.5017|-73.5673|us|-5">Montréal</option>
            <option value="46.8139|-71.2080|us|-5">Québec</option>
            <option value="40.7128|-74.0060|us|-5">New York</option>
          </optgroup>
          <option value="custom">✎ Autre (lat/lon manuels)</option>
        </select>
        <span class="at-select-chevron" aria-hidden="true" style="color:var(--emerald);">▾</span>
      </div>
      <div id="at-custom-coords" style="display:none;margin-top:0.6rem;">
        <div class="pyth-date-row">
          <div class="pyth-field pyth-field--wide">
            <input type="number" id="at-lat" class="pyth-input" min="-90" max="90" step="0.0001" placeholder="48.8566" aria-label="Latitude">
            <span class="pyth-field-label">Latitude (N+, S−)</span>
          </div>
          <div class="pyth-field pyth-field--wide">
            <input type="number" id="at-lon" class="pyth-input" min="-180" max="180" step="0.0001" placeholder="2.3522" aria-label="Longitude">
            <span class="pyth-field-label">Longitude (E+, O−)</span>
          </div>
          <div class="pyth-field">
            <input type="number" id="at-tz-offset" class="pyth-input" min="-12" max="14" step="0.5" placeholder="1" aria-label="Décalage UTC">
            <span class="pyth-field-label">Fuseau UTC</span>
          </div>
        </div>
      </div>
    </div>

    <div class="pyth-form-actions">
      <button type="button" id="at-exemple" class="pyth-btn-example">Essayer avec un exemple</button>
      <button type="submit" class="pyth-btn-calc" style="background:var(--emerald);color:#0f172a;box-shadow:0 4px 12px rgba(61,211,153,0.25);">Calculer mon thème stellaire ✦</button>
    </div>
  </form>

  <!-- ── RÉSULTATS ── -->
  <div id="atResultats" hidden>
    <div class="pyth-section-sep"></div>
    <div class="at-results-grid">
      <!-- Signe Solaire -->
      <div class="pyth-result-block">
        <h3 class="pyth-result-title at-highlight-title">
          <span class="at-title-left">
            <span class="at-dot at-dot-gold"></span>
            Signe Solaire Sidéral
          </span>
          <span class="at-hint">La position réelle devant les constellations</span>
        </h3>
        <div id="atSoleilCard"></div>
      </div>
      <!-- Ascendant -->
      <div class="pyth-result-block">
        <h3 class="pyth-result-title at-highlight-title">
          <span class="at-title-left">
            <span class="at-dot at-dot-violet"></span>
            Ascendant Sidéral <span class="at-title-badge">(Corrigé par Ayanamsa)</span>
          </span>
          <span class="at-hint">Le point exact se levant à l'horizon stellaire</span>
        </h3>
        <div id="atAscendantCard"></div>
      </div>
    </div>
    <!-- Synthèse combinée -->
    <div id="atComboBlock"></div>

    <!-- Toutes les Positions Planétaires -->
    <div id="atPlanetsSection" class="pyth-result-block" style="margin-top:2.5rem;">
      <h3 class="pyth-result-title at-highlight-title" style="margin-bottom:1.5rem;">
        <span class="at-title-left">
          <span class="at-dot at-dot-emerald"></span>
          ✦ Interprétation des Énergies Planétaires Sidérales
        </span>
      </h3>
      <div id="atPlanetsSummary" class="at-summary-container"></div>
      <div class="at-toggle-wrap">
        <button id="atTogglePlanetsBtn" class="at-toggle-detail-btn" type="button">
          <span>Développer le détail des positions planétaires</span>
          <span class="at-toggle-icon">▼</span>
        </button>
      </div>
      <div id="atPlanetsDetails" class="at-details-container" style="display: none;">
        <div id="atPlanetsBlock" class="at-planets-grid"></div>
      </div>
    </div>

    <!-- Aspects Planétaires Majeurs -->
    <div id="atAspectsSection" class="pyth-result-block" style="margin-top:2.5rem;">
      <h3 class="pyth-result-title at-highlight-title" style="margin-bottom:1.5rem;">
        <span class="at-title-left">
          <span class="at-dot at-dot-violet"></span>
          ✦ Analyse des Aspects Astrologiques Sidéraux
        </span>
      </h3>
      <div id="atAspectsSummary" class="at-summary-container"></div>
      <div class="at-toggle-wrap">
        <button id="atToggleAspectsBtn" class="at-toggle-detail-btn" type="button">
          <span>Développer le détail des aspects astrologiques</span>
          <span class="at-toggle-icon">▼</span>
        </button>
      </div>
      <div id="atAspectsDetails" class="at-details-container" style="display: none;">
        <div id="atAspectsBlock" class="at-aspects-grid"></div>
      </div>
    </div>

    <!-- Tableau de Synthèse Stellaire -->
    <div id="atSummaryTableSection" class="pyth-result-block" style="margin-top:2.5rem;">
      <h3 class="pyth-result-title at-highlight-title" style="margin-bottom:1.5rem;">
        <span class="at-title-left">
          <span class="at-dot at-dot-gold"></span>
          ✦ Synthèse Céleste Récapitulative
        </span>
      </h3>
      <div id="atSummaryTableBlock"></div>
    </div>

    <p class="at-disclaimer">
      ⚠ L'ascendant sidéral est calculé en temps universel (UT) avec soustraction automatique de l'Ayanamsa de Lahiri —
      fuseau appliqué : <span id="atTzNote" style="color:var(--emerald);font-weight:600;"></span>.
      Les longitudes tropicales intermédiaires sont converties en appliquant la formule de précession de l'époque J2000.
      Pour un thème sidéral védique certifié, veuillez consulter un astrologue Jyotish qualifié.
    </p>
  </div>
</section>

<!-- ═══════════ [02] COMPRENDRE L'AYANAMSA ═══════════ -->
<section id="l-ayanamsa">
  <div class="section-title">
    <div class="num" style="color:var(--emerald);border-color:rgba(61,211,153,0.3);">[ 02 ]</div>
    <h2>✦ L'Ayanamsa &amp; La Précession</h2>
    <p class="slate">Le cœur de la différence entre zodiaque Tropical et Sidéral repose sur un fait astronomique mesurable : la précession des équinoxes.</p>
  </div>

  <div class="at-method-block">
    <h3 class="at-method-h3" style="color:var(--emerald);">L'Équation Céleste</h3>
    <p class="at-method-p">L'axe de rotation de la Terre oscille lentement comme une toupie. Ce mouvement, appelé <strong>précession des équinoxes</strong>, décale lentement les équinoxes vers l'ouest le long de l'écliptique au rythme de 50,3 secondes d'arc par an (environ 1 degré tous les 72 ans).</p>
    
    <div class="pyth-diff-box" style="margin-top:1.5rem;border-color:rgba(61,211,153,0.3);">
      <div class="pyth-diff-title" style="color:var(--emerald);">☿ Tropical vs. Sidéral en chiffres</div>
      <div class="pyth-diff-grid">
        <div class="pyth-diff-item">
          <span class="pyth-diff-lbl cf-gold">Zodiaque Tropical</span>
          Ancré sur les solstices et les équinoxes. 0° Bélier coïncide toujours avec le début du printemps terrestre (21 mars). Il représente les cycles psychologiques terrestres.
        </div>
        <div class="pyth-diff-item">
          <span class="pyth-diff-lbl cf-emerald">Zodiaque Sidéral</span>
          Ancré sur les étoiles fixes. Il mesure la position exacte des planètes devant les constellations stellaires physiques. Il représente la réalité cosmique globale.
        </div>
        <div class="pyth-diff-item">
          <span class="pyth-diff-lbl cf-violet">L'Ayanamsa</span>
          L'écart angulaire exact entre les deux zodiaques. En l'an 2026, l'écart (Lahiri Ayanamsa) est de près de <strong>24° 13'</strong>, entraînant un décalage d'un signe complet pour 75% des personnes.
        </div>
      </div>
    </div>

    <!-- Personal Ayanamsa Box (Dynamic) -->
    <div id="atPersonalAyanamsaBox" class="at-personal-ayanamsa-box" style="display:none; margin-top:2rem; padding:1.5rem; background:rgba(61,211,153,0.03); border:1px dashed rgba(61,211,153,0.3); border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.15);">
      <!-- Filled dynamically by JS -->
    </div>
  </div>
</section>

<!-- ═══════════ [03] LES DOMINANTES STELLAIRES ═══════════ -->
<section id="les-dominantes">
  <div class="section-title">
    <div class="num" style="color:var(--emerald);border-color:rgba(61,211,153,0.3);">[ 03 ]</div>
    <h2>✦ Les Nakshatras &amp; Étoiles fixes</h2>
    <p class="slate">En astrologie védique sidérale, le zodiaque est subdivisé en 27 demeures lunaires appelées Nakshatras, apportant une précision psychologique supérieure.</p>
  </div>

  <div class="at-method-block">
    <p class="at-method-p">Chaque Nakshatra s'étend sur exactement 13° 20' de l'écliptique et est régi par une planète et une divinité védique. Ce niveau d'interprétation sidérale examine les forces karmiques profondes de votre personnalité, alors que le signe solaire décrit la façade et le moteur de l'ego.</p>
    <p class="at-method-note" style="background:rgba(61,211,153,0.04);border-left-color:var(--emerald);">
      Le point de repère de départ du zodiaque védique moderne est l'étoile <strong>Spica (Chitra Nakshatra)</strong>, située exactement à 180° du point vernal de référence historique. C'est l'ancre mathématique de l'ayanamsa de Lahiri.
    </p>

    <!-- Personal Nakshatras Box (Dynamic) -->
    <div id="atPersonalNakshatrasBox" class="at-personal-nakshatras-box" style="display:none; margin-top:2rem; padding:1.5rem; background:rgba(61,211,153,0.03); border:1px dashed rgba(61,211,153,0.3); border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.15);">
      <!-- Filled dynamically by JS -->
    </div>
  </div>
</section>



<p slot="sources" style="color:#64748b;font-size:0.75rem;margin-bottom:0.8rem;">
  Sources : N.C. Lahiri, <em>Tables of Ascendants</em> · BV Raman, <em>A Manual of Hindu Astrology</em> · Yukteswar Giri, <em>The Holy Science</em> · Fagan &amp; Bradley, <em>Primer of Sidereal Astrology</em> · Linda Johnsen, <em>A Thousand Suns</em>
</p>

<!-- ═══════════ NAVIGATION PRÉCÉDENT / SUIVANT ═══════════ -->
<nav class="sub-nav" style="display:flex;justify-content:space-between;max-width:600px;margin:2rem auto;padding:1rem;">
  <a href="/astrologie/tropicale/" style="color:var(--cyan);font-family:var(--font-mono);">← Astrologie Tropicale</a>
  <a href="/astrologie/vedique/" style="color:var(--cyan);font-family:var(--font-mono);">Astrologie Védique →</a>
</nav>

</Layout>

<style is:global>
/* ─── Résultat dots ─── */
.at-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 0.5rem; vertical-align: middle; flex-shrink: 0; }
.at-dot-gold { background: var(--gold); }
.at-dot-violet { background: var(--violet); }
.at-hint { font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); font-weight: 400; margin-left: 0.6rem; vertical-align: middle; }

/* ─── Sélecteur de ville ─── */
.at-select-wrap { position: relative; max-width: 420px; }
.at-select-native {
  width: 100%; appearance: none; cursor: pointer;
  background: rgba(255,255,255,0.04);
  border: 1px solid #334155; border-radius: 8px;
  color: var(--text); padding: 0.65rem 2.6rem 0.65rem 0.9rem;
  font-size: 0.9rem; font-family: inherit;
  transition: border-color 0.2s;
}
.at-select-native:hover { border-color: #64748b; }
.at-select-native:focus { border-color: var(--emerald); outline: 2px solid rgba(61,211,153,0.18); outline-offset: 2px; }
.at-select-native option,
.at-select-native optgroup { background: #1e293b; color: var(--text); }
.at-select-chevron { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--gold); pointer-events: none; font-size: 0.95rem; }

/* ─── Résultats grille ─── */
.at-results-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }

/* ─── Disclaimer ─── */
.at-disclaimer { font-size: 0.79rem; color: var(--text-muted); margin-top: 1.2rem; padding: 0.7rem 1rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; line-height: 1.6; }

/* ─── Cards résultat ─── */
.at-result-card { background: rgba(255,255,255,0.03); border: 1px solid #1e293b; border-radius: 12px; padding: 1.5rem; }
.at-rc-header { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1rem; }
.at-rc-sym { font-size: 2.8rem; line-height: 1; flex-shrink: 0; }
.at-rc-name { font-size: 1.3rem; font-weight: 700; }
.at-rc-dates { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.2rem; }
.at-rc-badges { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.6rem; }
.at-rc-badge { font-family: var(--font-mono); font-size: 0.72rem; padding: 0.2rem 0.55rem; border-radius: 4px; border: 1px solid #334155; background: rgba(255,255,255,0.04); color: var(--slate); }
.at-rc-kw { font-size: 0.88rem; color: var(--slate); font-style: italic; margin: 0.8rem 0; line-height: 1.6; }
.at-rc-interp { font-size: 0.87rem; line-height: 1.75; color: #d0d6e0; }
.at-rc-deg { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem; }

/* ─── Tableau ─── */
.at-table-wrap { overflow-x: auto; margin-bottom: 2rem; }
.at-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
