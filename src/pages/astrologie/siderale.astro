---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "name": "Astrologie Sidérale — Le zodiaque des étoiles fixes",
  "url": "https://mysteres.fr/astrologie/siderale.html",
  "description": "Découvrez l'astrologie sidérale, basée sur la position réelle des constellations.",
  "inLanguage": "fr"
};
---

<Layout
  title="Astrologie Sidérale — Astrologie"
  description="Découvrez l'astrologie sidérale, basée sur la position réelle des constellations. Utilisée en Inde (Jyotish) et de plus en plus populaire en Occident."
  keywords="astrologie sidérale, zodiaque sidéral, constellations, jyotish, étoiles fixes"
  canonicalPath="astrologie/siderale.html"
  jsonLd={jsonLd}
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);">
  <a href="../index.html" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="index.html" style="color:var(--cyan);">Astrologie</a> &rsaquo;
  <span style="color:var(--text-primary);">Astrologie Sidérale</span>
</nav>

<!-- ═══════════ BANNIÈRE "BIENTÔT" ═══════════ -->
<section id="hero" style="text-align:center;padding:6rem 1.5rem 4rem;max-width:700px;margin:0 auto;">
  <h1>
    <span class="pulse"></span>
    ⭐ <span class="gold">Astrologie Sidérale</span><br>Le zodiaque des <span class="emerald">étoiles fixes</span>
  </h1>
  <p class="subtitle">
    Cette section est en cours de création. L'astrologie sidérale, basée sur la position réelle des constellations, est utilisée en Inde (Jyotish) et gagne en popularité en Occident. Revenez bientôt !
  </p>
  <a href="../astrologie/index.html" class="cta">← Retour à l'Astrologie</a>
</section>

<!-- ═══════════ NAVIGATION PRÉCÉDENT / SUIVANT ═══════════ -->
<nav class="sub-nav" style="display:flex;justify-content:space-between;max-width:600px;margin:2rem auto;padding:1rem;">
