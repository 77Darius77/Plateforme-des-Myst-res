---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "name": "Astrologie Védique (Jyotish) — La science de la lumière",
  "url": "https://mysteres.fr/astrologie/vedique.html",
  "description": "Découvrez l'astrologie védique ou Jyotish, pilier de la tradition hindoue.",
  "inLanguage": "fr"
