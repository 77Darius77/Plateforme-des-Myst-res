.at-bhava-planets-list { display: flex; flex-wrap: wrap; gap: 0.35rem; }
.at-bhava-planet-tag { font-size: 0.74rem; font-family: var(--font-mono); padding: 0.15rem 0.45rem; border-radius: 4px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: #e2e8f0; }
