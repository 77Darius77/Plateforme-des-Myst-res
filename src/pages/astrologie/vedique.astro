/* ─── Titres résultats ─── */
.pyth-result-block .at-highlight-title { font-family: var(--font-mono); font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.08em; color: #f8fafc; font-weight: 700; margin-top: 1.8rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; width: 100%; flex-wrap: wrap; gap: 0.5rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.09); padding-bottom: 0.8rem; text-shadow: 0 2px 10px rgba(0,0,0,0.4); }
.at-title-left { display: inline-flex; align-items: center; gap: 0.6rem; }
