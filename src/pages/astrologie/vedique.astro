/* ─── Dasha Timeline ─── */
.at-dasha-timeline { position: relative; margin: 2rem 0; padding-left: 2rem; border-left: 2px solid rgba(183,139,250,0.15); }
.at-dasha-item { position: relative; margin-bottom: 2rem; transition: all 0.3s ease; }
