/* ─── Toggle déroulant ─── */
.at-toggle-wrap { margin: 1rem 0 0; }
.at-toggle-detail-btn--violet { background: rgba(183,139,250,0.05); border: 1px solid rgba(183,139,250,0.25); color: var(--violet); padding: 0.75rem 1.5rem; border-radius: 8px; font-family: var(--font-mono); font-size: 0.85rem; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 0.75rem; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
