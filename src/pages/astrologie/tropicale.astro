---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "name": "Astrologie Tropicale — Le zodiaque des saisons",
  "url": "https://mysteres.fr/astrologie/tropicale.html",
  "description": "Découvrez l'astrologie tropicale, basée sur les saisons et le point vernal.",
  "inLanguage": "fr"
};
---

<Layout
  title="Astrologie Tropicale — Astrologie"
  description="Découvrez l'astrologie tropicale, basée sur les saisons et le point vernal. La plus pratiquée en Occident pour le signe solaire, l'ascendant et le thème natal."
  keywords="astrologie tropicale, zodiaque, signe solaire, ascendant, thème natal, point vernal"
  canonicalPath="astrologie/tropicale.html"
  jsonLd={jsonLd}
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);">
  <a href="../index.html" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="index.html" style="color:var(--cyan);">Astrologie</a> &rsaquo;
  <span style="color:var(--text-primary);">Astrologie Tropicale</span>
</nav>

<!-- ═══════════ BANNIÈRE "BIENTÔT" ═══════════ -->
<section id="hero" style="text-align:center;padding:6rem 1.5rem 4rem;max-width:700px;margin:0 auto;">
  <h1>
    <span class="pulse"></span>
    ⭐ <span class="gold">Astrologie Tropicale</span><br>Le zodiaque des <span class="emerald">saisons</span>
  </h1>
  <p class="subtitle">
    Cette section est en cours de création. L'astrologie tropicale, basée sur les saisons et le point vernal, est la plus pratiquée en Occident. Découvrez votre signe solaire, votre ascendant, et votre thème natal complet. Revenez bientôt !
  </p>
  <a href="../astrologie/index.html" class="cta">← Retour à l'Astrologie</a>
</section>

<!-- ═══════════ NAVIGATION PRÉCÉDENT / SUIVANT ═══════════ -->
<nav class="sub-nav" style="display:flex;justify-content:space-between;max-width:600px;margin:2rem auto;padding:1rem;">
  <span></span>
  <a href="siderale.html" style="color:var(--cyan);font-family:var(--font-mono);">Astrologie Sidérale →</a>
</nav>

</Layout>
