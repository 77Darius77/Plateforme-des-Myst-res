---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Tirage en Étoile — Oracle Gé"
  description="Effectuez un tirage en Étoile gratuit avec l'Oracle Gé. 7 cartes pour explorer tous les aspects de votre vie."
  keywords="oracle gé, tirage en étoile, géomancie, voyance gratuite, tirage 7 cartes"
  canonicalPath="oracles/ge/etoile/"
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Oracles", item: "https://plateforme-des-mysteres.com/oracles/" },
    { name: "Oracle Gé", item: "https://plateforme-des-mysteres.com/oracles/ge/" },
    { name: "Tirage en Étoile", item: "https://plateforme-des-mysteres.com/oracles/ge/etoile/" }
  ]}
  section="oracles"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/oracles/" style="color:var(--cyan);">Oracles</a> &rsaquo;
  <a href="/oracles/ge/" style="color:var(--cyan);">Oracle Gé</a> &rsaquo;
  <span style="color:var(--text);">Tirage en Étoile</span>
</nav>

<main style="max-width:1300px;margin:0 auto;padding:2rem 1.5rem;text-align:center;">
  <h1>Tirage en <span class="gold">Étoile</span></h1>
  <p class="subtitle">Concentrez-vous sur votre question. L'Étoile déploie 7 cartes autour de votre cœur pour éclairer chaque dimension de votre vie.</p>

  <div id="deck-area" style="margin-top:2rem;position:relative;height:250px;display:flex;justify-content:center;align-items:center;">
    <button id="btn-spread" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;z-index:10;">Étaler les cartes ✦</button>
    
    <div id="spread-container" style="display:none;position:relative;width:100%;height:100%;max-width:1000px;margin:0 auto;">
      <p id="instruction-text" style="position:absolute;top:-40px;width:100%;color:var(--gold);font-weight:bold;font-size:1.1rem;">Sélectionnez 7 cartes (0/7)</p>
    </div>
  </div>

  <div id="resultats" style="margin-top:3rem;">
    <div class="etoile-grid">

      <!-- Carte 1 : Centre (cœur) - proéminente -->
      <div class="tarot-card-container etoile-center">
        <div class="tarot-pos tarot-pos-center">✦ 1. Centre (cœur) ✦</div>
        <div class="tarot-card" id="slot-1">
          <div class="card-inner">
            <div class="card-front empty-slot" style="border-color:var(--gold);"></div>
            <div class="card-back" style="border-color:var(--gold);">
              <img id="img-1" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>

      <!-- Anneau extérieur : 6 cartes autour -->
      <div class="etoile-ring">

        <div class="tarot-card-container">
          <div class="tarot-pos">2. Finances</div>
          <div class="tarot-card" id="slot-2">
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back">
                <img id="img-2" src="" alt="" loading="lazy" class="card-img">
              </div>
            </div>
          </div>
        </div>

        <div class="tarot-card-container">
          <div class="tarot-pos">3. Sentiments</div>
          <div class="tarot-card" id="slot-3">
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back">
                <img id="img-3" src="" alt="" loading="lazy" class="card-img">
              </div>
            </div>
          </div>
        </div>

        <div class="tarot-card-container">
          <div class="tarot-pos">4. Santé</div>
          <div class="tarot-card" id="slot-4">
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back">
                <img id="img-4" src="" alt="" loading="lazy" class="card-img">
              </div>
            </div>
          </div>
        </div>

        <div class="tarot-card-container">
          <div class="tarot-pos">5. Travail</div>
          <div class="tarot-card" id="slot-5">
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back">
                <img id="img-5" src="" alt="" loading="lazy" class="card-img">
              </div>
            </div>
          </div>
        </div>

        <div class="tarot-card-container">
          <div class="tarot-pos">6. Spiritualité</div>
          <div class="tarot-card" id="slot-6">
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back">
                <img id="img-6" src="" alt="" loading="lazy" class="card-img">
              </div>
            </div>
          </div>
        </div>

        <div class="tarot-card-container">
          <div class="tarot-pos">7. Résultat</div>
          <div class="tarot-card" id="slot-7">
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back" style="border-color:var(--gold);">
                <img id="img-7" src="" alt="" loading="lazy" class="card-img">
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
    
    <div id="reveal-area" style="display:none;margin-top:2rem;">
      <button id="btn-reveal" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;">Révéler le tirage ✦</button>
    </div>

    <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

    <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);">Ce tirage vous offre des pistes de réflexion. Le libre arbitre reste votre meilleur guide.</p>
  </div>
</main>

<style>
  .etoile-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .etoile-center {
    width: 273px;
  }
  .etoile-ring {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .tarot-card-container { width: 163px; }
  .tarot-pos { font-family: var(--font-mono); font-size: 0.7rem; color: var(--gold); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.5px; }
  .tarot-pos-center { color: var(--gold); font-weight: bold; font-size: 0.75rem; }
  .tarot-card { width: 100%; height: 294px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .tarot-card.flipped .card-inner { transform: rotateY(180deg); }
  
  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--gold); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 0.6rem; }
  
  .card-front { 
    background-image: url('/images/oracles/ge-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center;
  }
  
  .empty-slot {
    background: rgba(218, 165, 32, 0.03);
    background-image: none;
    border: 2px dashed rgba(218, 165, 32, 0.4);
  }
  .filled-slot {
    background-image: url('/images/oracles/ge-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--gold);
    box-shadow: 0 0 8px rgba(218, 165, 32, 0.3);
  }
  
  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow: hidden; justify-content: center; align-items: center; padding: 0; }
  .card-back h3 { color: var(--gold); font-size: 0.85rem; margin-bottom: 0.15rem; padding-bottom: 0.15rem; width: 100%; }
  .card-img { width: 99%; height: auto; max-height: 100%; border-radius: 4px; object-fit: contain; margin: 0 0 0.2rem; }
  .meaning { font-size: 0.7rem; line-height: 1.35; color: var(--text-muted); text-align: left; }

  @media (max-width: 1100px) {
    .tarot-card-container { width: 137px; }
    .tarot-card { height: 263px; }
    .etoile-center { width: 210px; }
  }
</style>

<style is:global>
  .spread-card {
    position: absolute;
    width: 56px;
    height: 100px;
    background-image: url('/images/oracles/ge-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--gold);
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 60px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 4px rgba(218, 165, 32, 0.15);
  }
  .spread-card:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 12px rgba(218, 165, 32, 0.5);
  }
  .spread-card.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .tr-rev {
    color: var(--orange, #f59e0b);
    font-style: italic;
    font-size: 0.8em;
    margin-left: 0.3em;
  }
</style>

<script is:inline src="/js/ge-data.js"></script>
<script is:inline src="/js/ge-interp.js"></script>
<script is:inline src="/js/ge-planes.js"></script>
<script is:inline>
  function initBellineSpread() {
    const btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    const MAX_CARDS = 7;
    let selectedCards = [];
    let deckIndices = [];

    const newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', () => {
      newBtnSpread.style.display = 'none';
      const container = document.getElementById('spread-container');
      container.style.display = 'block';
      
      container.querySelectorAll('.spread-card').forEach(c => c.remove());
      
      const deckSize = window.geData.length;
      deckIndices = Array.from({length: deckSize}, (_, i) => i).sort(() => 0.5 - Math.random());
      
      void container.offsetWidth;
      const containerWidth = container.offsetWidth > 0 ? container.offsetWidth : Math.min(window.innerWidth - 40, 1000);
      const cardWidth = 56;
      const step = (containerWidth - cardWidth) / (deckSize - 1);
      
      for(let i=0; i<deckSize; i++) {
        const card = document.createElement('div');
        card.className = 'spread-card';
        card.style.left = `${i * step}px`;
        card.style.zIndex = i;
        
        const middle = (deckSize - 1) / 2;
        const distanceFromCenter = Math.abs(i - middle);
        const yOffset = (distanceFromCenter * distanceFromCenter) * 0.03;
        const rotation = (i - middle) * (40 / deckSize);
        
        const cardData = window.geData[deckIndices[i]];
        const isReversed = !cardData.oneWay && Math.random() < 0.45;
        const effectiveRotation = rotation + (isReversed ? 180 : 0);
        card.style.transform = `translateY(${yOffset}px) rotate(${effectiveRotation}deg)`;
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        card.dataset.reversed = isReversed ? 'true' : 'false';
        if (isReversed) card.classList.add('reversed');
        
        card.addEventListener('click', () => selectCard(card));
        container.appendChild(card);
      }
    });

    function selectCard(cardEl) {
      if(selectedCards.length >= MAX_CARDS) return;
      
      cardEl.classList.add('selected');
      const actualCardData = window.geData[cardEl.dataset.index];
      const cardWithReversal = Object.assign({}, actualCardData);
      cardWithReversal.reversed = cardEl.dataset.reversed === 'true';
      selectedCards.push(cardWithReversal);
      
      const slotIdx = selectedCards.length;
      const slotFront = document.querySelector(`#slot-${slotIdx} .card-front`);
      if(slotFront) {
        slotFront.classList.remove('empty-slot');
        slotFront.classList.add('filled-slot');
      }
      
      const instr = document.getElementById('instruction-text');
      if(instr) instr.innerText = `Sélectionnez ${MAX_CARDS} cartes (${selectedCards.length}/${MAX_CARDS})`;
      
      if(selectedCards.length === MAX_CARDS) {
        if(instr) instr.innerText = "Tirage complet.";
        setTimeout(() => {
          document.getElementById('deck-area').style.display = 'none';
          document.getElementById('reveal-area').style.display = 'block';
        }, 800);
      }
    }

    const btnReveal = document.getElementById('btn-reveal');
    if (btnReveal) {
      const newBtnReveal = btnReveal.cloneNode(true);
      btnReveal.parentNode.replaceChild(newBtnReveal, btnReveal);
      newBtnReveal.addEventListener('click', () => {
        newBtnReveal.style.display = 'none';

        setTimeout(() => {
          for(let i=1; i<=MAX_CARDS; i++) {
            const cardData = selectedCards[i-1];
            const imgEl = document.getElementById(`img-${i}`);
            const cardNum = cardData.number !== undefined ? cardData.number : (cardData.id || i);
            imgEl.src = `/images/oracles/ge/card_${String(cardNum).padStart(2, '0')}.webp`;
            imgEl.onerror = function() { this.style.display = 'none'; };
            if (cardData.reversed) imgEl.style.transform = 'rotate(180deg)';
            setTimeout(() => {
              document.getElementById(`slot-${i}`).classList.add('flipped');
            }, i * 200);
          }
        }, 100);

        setTimeout(() => {
          const rs = document.getElementById('reading-section');
          if (rs && window.geInterp) {
            rs.innerHTML = window.geInterp.generateReadingWithPlanes('etoile', selectedCards);
            setTimeout(function() { initPlaneTabs(); }, 100);
            rs.style.display = 'block';
            rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 2500);
      });
    }
  }


  function initPlaneTabs() {
    document.querySelectorAll('.tr-plane-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        var plane = this.dataset.plane;
        document.querySelectorAll('.tr-plane-tab').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        document.querySelectorAll('.tr-plane-pane').forEach(function(p) { p.classList.remove('active'); });
        var pane = document.querySelector('.tr-plane-pane[data-plane="' + plane + '"]');
        if (pane) pane.classList.add('active');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBellineSpread);
  } else {
    initBellineSpread();
  }
  document.addEventListener('astro:page-load', initBellineSpread);
</script>

</Layout>
