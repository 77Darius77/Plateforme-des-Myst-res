---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Tirage à 3 Cartes — Oracle de la Triade | Plateforme des Mystères"
  description="Tirage gratuit à 3 cartes de l'Oracle de la Triade. Passé, Présent, Futur. Interprétation détaillée sur 3 plans."
  keywords="oracle triade tirage 3 cartes, tirage triade gratuit, triade passé présent futur"
  canonicalPath="oracles/triade/trois-cartes/"
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Oracles", item: "https://plateforme-des-mysteres.com/oracles/" },
    { name: "Oracle de la Triade", item: "https://plateforme-des-mysteres.com/oracles/triade/" },
    { name: "Tirage à 3 Cartes", item: "https://plateforme-des-mysteres.com/oracles/triade/trois-cartes/" }
  ]}
  section="oracles"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/../" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/" style="color:var(--cyan);">Oracles</a> &rsaquo;
  <a href="/oracles/triade/" style="color:var(--cyan);">Oracle de la Triade</a> &rsaquo;
  <span style="color:var(--text);">Tirage à 3 Cartes</span>
</nav>

<main style="max-width:900px;margin:0 auto;padding:1.5rem;">
  <header style="text-align:center;margin-bottom:2rem;">
    <h1 style="font-family:var(--font-display);font-size:2rem;margin:0;">
      <span class="gold">Tirage à 3 Cartes</span>
    </h1>
    <p style="color:var(--cyan);font-family:var(--font-mono);font-size:0.85rem;">Passé · Présent · Futur</p>
  </header>

  <div style="text-align:center;margin-bottom:1.5rem;">
    <button id="btn-spread" style="padding:0.8rem 2rem;background:transparent;border:2px solid var(--cyan);color:var(--cyan);border-radius:8px;cursor:pointer;font-family:var(--font-mono);font-size:0.95rem;transition:all 0.3s;"
      onmouseover="this.style.background='var(--cyan)';this.style.color='#0a0a1a';"
      onmouseout="this.style.background='transparent';this.style.color='var(--cyan)';">
      🔺 BRASSER ET TIRER
    </button>
  </div>

  <div id="spread-container" style="display:none;margin-bottom:2rem;">
    <p style="text-align:center;color:var(--text-muted);font-size:0.8rem;margin-bottom:0.5rem;">Sélectionnez 3 cartes dans l'éventail</p>
    <div id="card-counter" style="text-align:center;color:var(--cyan);font-family:var(--font-mono);font-size:1.1rem;font-weight:bold;margin-bottom:0.5rem;">0 / 3</div>
    <div id="spread-row" style="position:relative;height:160px;overflow:visible;"></div>
  </div>

  <div id="selected-container" style="margin-bottom:2rem;">
    <div style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;" id="selected-row">
      <div class="tarot-card-container">
        <div class="tarot-pos">1. Le Passé</div>
        <div class="tarot-card" id="slot-0">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-0" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>
      <div class="tarot-card-container">
        <div class="tarot-pos">2. Le Présent</div>
        <div class="tarot-card" id="slot-1">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-1" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>
      <div class="tarot-card-container">
        <div class="tarot-pos">3. Le Futur</div>
        <div class="tarot-card" id="slot-2">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-2" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="reveal-container" style="display:none;text-align:center;margin-bottom:2rem;">
    <button id="btn-reveal" style="padding:0.8rem 2rem;background:transparent;border:2px solid var(--gold);color:var(--gold);border-radius:8px;cursor:pointer;font-family:var(--font-mono);font-size:0.95rem;transition:all 0.3s;"
      onmouseover="this.style.background='var(--gold)';this.style.color='#0a0a1a';"
      onmouseout="this.style.background='transparent';this.style.color='var(--gold)';">
      ✦ RÉVÉLER LES CARTES
    </button>
  </div>

  <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

  <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);text-align:center;">
    Ce tirage vous offre des pistes de réflexion. Le libre arbitre reste votre meilleur guide.
  </p>

  <div style="max-width:720px;margin:3rem auto 1rem;text-align:left;padding:0 1rem;"><h2 style="font-size:1.3rem;color:var(--gold);margin-bottom:1rem;">L'Oracle Triade — Corps, Âme, Esprit</h2><p style="color:var(--text-dim);line-height:1.8;margin-bottom:1rem;">Outil de lecture intuitive structuré autour de la tripartition Corps, Âme et Esprit. La carte Corps parle de votre ancrage, la carte Âme de vos émotions, la carte Esprit de votre direction.</p><p style="color:var(--text-dim);line-height:1.8;">Respirez profondément avant de tirer. Laissez chaque carte vous parler.</p></div>
</main>

<style>
  .tarot-card-container { width: 260px; }
  .tarot-pos { font-family: var(--font-mono); font-size: 0.85rem; color: var(--gold); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
  .tarot-card { width: 100%; height: 460px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .tarot-card.flipped .card-inner { transform: rotateY(180deg); }

  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--cyan); display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0.6rem; }

  .card-front {
    background-image: url('/images/oracles/triade-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center;
  }

  .empty-slot {
    background: rgba(var(--cyan-rgb), 0.03);
    background-image: none;
    border: 2px dashed rgba(var(--cyan-rgb), 0.4);
  }
  .filled-slot {
    background-image: url('/images/oracles/triade-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--cyan);
    box-shadow: 0 0 8px rgba(var(--cyan-rgb), 0.3);
  }

  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow: hidden; justify-content: center; align-items: center; padding: 0; }
  .card-back h3 { font-size: 1.15rem; margin-bottom: 0.2rem; padding-bottom: 0.2rem; width: 100%; color: var(--gold); }
  .card-img { width: 100%; height: auto; max-height: 90%; border-radius: 4px; object-fit: contain; margin: 0 0 0.2rem; }
  .meaning { font-size: 0.82rem; line-height: 1.5; color: var(--text-muted); text-align: left; }

  @media (max-width: 768px) {
    .tarot-card-container { width: 220px; }
    .tarot-card { height: 400px; }
  }
</style>

<style is:global>
  .spread-card {
    position: absolute;
    width: 56px;
    height: 100px;
    background-image: url('/images/oracles/triade-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--cyan);
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 60px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 4px rgba(var(--cyan-rgb), 0.15);
  }
  .spread-card:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 12px rgba(var(--cyan-rgb), 0.5);
  }
  .spread-card.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>

<script is:inline src="/js/triade-data.js"></script>
<script is:inline src="/js/triade-interp.js"></script>
<script is:inline src="/js/triade-planes.js"></script>
<script is:inline>
  function initBellineSpread() {
    const btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    const MAX_CARDS = 3;
    let selectedCards = [];
    let deckIndices = [];

    const newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', () => {
      newBtnSpread.style.display = 'none';
      const container = document.getElementById('spread-container');
      container.style.display = 'block';

      const row = document.getElementById('spread-row');
      row.innerHTML = '';
      void row.offsetWidth;
      const containerWidth = row.offsetWidth > 0 ? row.offsetWidth : Math.min(window.innerWidth - 40, 900);
      const deckSize = 57;
      deckIndices = Array.from({length: deckSize}, (_, i) => i).sort(() => 0.5 - Math.random());
      const cardWidth = 56;
      const step = (containerWidth - cardWidth) / Math.max(deckSize - 1, 1);

      deckIndices.forEach((cardIdx, i) => {
        const card = document.createElement('div');
        card.className = 'spread-card';
        card.style.left = `${i * step}px`;
        card.style.zIndex = i;
        const middle = (deckSize - 1) / 2;
        const distanceFromCenter = Math.abs(i - middle);
        const yOffset = (distanceFromCenter * distanceFromCenter) * 0.03;
        const rotation = (i - middle) * (40 / deckSize);
        card.style.transform = `translateY(${yOffset}px) rotate(${rotation}deg)`;
        card.dataset.index = cardIdx;
        card.dataset.id = i;
        card.addEventListener('click', () => selectCard(card));
        row.appendChild(card);
      });
    });

    function selectCard(cardEl) {
      if(selectedCards.length >= MAX_CARDS) return;
      cardEl.classList.add('selected');
      const cardData = window.triadeData[cardEl.dataset.index];
      selectedCards.push(cardData);
      document.getElementById('card-counter').innerText = `${selectedCards.length} / ${MAX_CARDS}`;

      const posKey = selectedCards.length - 1;
      const slot = document.getElementById(`slot-${posKey}`);
      const frontEl = slot.querySelector('.card-front');

      // Ne pas flipper tout de suite — remplir en arrière-plan
      frontEl.classList.remove('empty-slot');
      frontEl.classList.add('filled-slot');

      const imgEl = document.getElementById(`img-${posKey}`);
      imgEl.src = `/images/oracles/triade/card_${cardData.id}.webp`;
      imgEl.onerror = function() { this.style.display = 'none'; };

      if (selectedCards.length === MAX_CARDS) {
        document.getElementById('reveal-container').style.display = 'block';
      }
    }

    document.getElementById('btn-reveal').addEventListener('click', () => {
      document.getElementById('reveal-container').style.display = 'none';
      for (let i = 0; i < MAX_CARDS; i++) {
        document.getElementById(`slot-${i}`).classList.add('flipped');
      }
      setTimeout(() => {
        const reading = window.triadeInterp.generateReadingHtml(selectedCards, 'TROIS_CARTES');
        const planesHTML = buildPlanesHTML(selectedCards);
        document.getElementById('reading-section').innerHTML = reading + planesHTML;
        document.getElementById('reading-section').style.display = 'block';
      }, 600);
    });

    function buildPlanesHTML(cards) {
      window._lastSelectedCards = cards;
      const planes = ['personnel', 'professionnel', 'argent', 'relationnel'];
      const activePlane = 'personnel';
      let html = '<div style="margin-top:2rem;"><div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap;">';
      planes.forEach(p => {
        const proj = window.triadePlanes.projectSpread(cards, p);
        html += `<button onclick="switchPlane('${p}')" id="tab-${p}" class="plane-tab" style="padding:0.4rem 1rem;border:1px solid var(--cyan);border-radius:6px;background:${p===activePlane?'rgba(var(--cyan-rgb),0.15)':'transparent'};color:var(--cyan);cursor:pointer;font-family:var(--font-mono);font-size:0.78rem;">${proj.planeLabel}</button>`;
      });
      html += '</div><div id="plane-content"></div></div>';
      setTimeout(() => { switchPlane(activePlane); }, 100);
      return html;
    }
  }

  function switchPlane(plane) {
    const cards = window._lastSelectedCards || [];
    if (!cards.length) return;
    const proj = window.triadePlanes.projectSpread(cards, plane);
    let html = `<p style="color:var(--text-muted);font-style:italic;margin-bottom:1rem;">${proj.intro}</p>`;
    proj.entries.forEach(e => {
      html += `<div style="margin-bottom:1rem;padding:0.8rem;background:rgba(var(--cyan-rgb),0.04);border-radius:8px;border-left:3px solid var(--cyan);">
        <strong style="color:var(--gold);">${e.cardName}</strong> <span style="color:var(--cyan);font-size:0.8rem;">· ${e.kw}</span>
        <p style="color:var(--text-muted);font-size:0.85rem;margin:0.3rem 0 0;">${e.text}</p>
      </div>`;
    });
    html += `<p style="color:var(--text-muted);font-style:italic;margin-top:1rem;font-size:0.85rem;">${proj.synth}</p>`;
    document.getElementById('plane-content').innerHTML = html;
    ['personnel','professionnel','argent','relationnel'].forEach(p => {
      const tab = document.getElementById(`tab-${p}`);
      if (tab) tab.style.background = p === plane ? 'rgba(var(--cyan-rgb),0.15)' : 'transparent';
    });
  }

  window.addEventListener('DOMContentLoaded', initBellineSpread);
</script>

</Layout>
