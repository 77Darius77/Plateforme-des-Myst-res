---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Croix des Reflets — Oracle des Miroirs"
  description="Effectuez un tirage gratuit en Croix des Reflets avec l'Oracle des Miroirs. 5 cartes pour une analyse nuancée de votre situation."
  keywords="oracle des miroirs, croix des reflets, tirage 5 cartes, voyance, décision, guidance"
  canonicalPath="oracles/miroirs/croix/"
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Oracles", item: "https://plateforme-des-mysteres.com/oracles/" },
    { name: "Oracle des Miroirs", item: "https://plateforme-des-mysteres.com/oracles/miroirs/" },
    { name: "Croix des Reflets", item: "https://plateforme-des-mysteres.com/oracles/miroirs/croix/" }
  ]}
  section="oracles"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/oracles/" style="color:var(--cyan);">Oracles</a> &rsaquo;
  <a href="/oracles/miroirs/" style="color:var(--cyan);">Oracle des Miroirs</a> &rsaquo;
  <span style="color:var(--text);">Croix des Reflets</span>
</nav>

<main style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;text-align:center;">
  <h1>Croix des <span class="gold">Reflets</span></h1>
  <p class="subtitle">Concentrez-vous sur votre question. Étalez les cartes, puis choisissez-en 5.</p>

  <div id="deck-area" style="margin-top:2rem;position:relative;height:250px;display:flex;justify-content:center;align-items:center;">
    <button id="btn-spread" class="btn-explore" style="z-index:10;">Étaler les cartes ✦</button>
    
    <div id="spread-container" style="display:none;position:relative;width:100%;height:100%;max-width:800px;margin:0 auto;">
      <p id="instruction-text" style="position:absolute;top:-40px;width:100%;color:var(--gold-text);font-weight:bold;font-size:1.1rem;">Sélectionnez 5 cartes (0/5)</p>
    </div>
  </div>

  <div id="resultats" style="margin-top:3rem;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto auto;gap:1rem;justify-items:center;align-items:center;max-width:900px;margin:0 auto;">
      <!-- Top -->
      <div></div>
      <div class="tarot-card-container">
        <div class="tarot-pos">4. L'Idéal</div>
        <div class="tarot-card" id="slot-4">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-4" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>
      <div></div>

      <!-- Left, Center, Right -->
      <div class="tarot-card-container">
        <div class="tarot-pos">2. Soutien</div>
        <div class="tarot-card" id="slot-2">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-2" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>

      <div class="tarot-card-container">
        <div class="tarot-pos">1. Cœur</div>
        <div class="tarot-card" id="slot-1">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-1" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>

      <div class="tarot-card-container">
        <div class="tarot-pos">3. Défi</div>
        <div class="tarot-card" id="slot-3">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-3" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom -->
      <div></div>
      <div class="tarot-card-container">
        <div class="tarot-pos">5. Fondement</div>
        <div class="tarot-card" id="slot-5">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-5" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>
      <div></div>
    </div>
    
    <div id="reveal-area" style="display:none;margin-top:2rem;">
      <button id="btn-reveal" class="btn-explore">Révéler le tirage ✦</button>
    </div>

    <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

    <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);">Ce tirage vous offre des pistes de réflexion. Le libre arbitre reste votre meilleur guide.</p>
  </div>
</main>

<style>
  .tarot-card-container { width: 230px; }
  .tarot-pos { font-family: var(--font-mono); font-size: 0.8rem; color: var(--gold-text); margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 1px; }
  .tarot-card { width: 100%; height: 370px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .tarot-card.flipped .card-inner { transform: rotateY(180deg); }
  
  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--gold); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 0.6rem; }
  
  .card-front { 
    background-image: url('/images/oracles/miroirs-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center;
  }
  
  .empty-slot {
    background: rgba(218, 165, 32, 0.03);
    background-image: none;
    border: 2px dashed rgba(218, 165, 32, 0.4);
  }
  .filled-slot {
    background-image: url('/images/oracles/miroirs-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--gold);
    box-shadow: 0 0 8px rgba(218, 165, 32, 0.3);
  }
  
  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow: hidden; justify-content: center; align-items: center; padding: 0; }
  .card-img { width: 100%; height: auto; max-height: 100%; border-radius: 4px; object-fit: contain; margin: 0 0 0.2rem; }

  @media (max-width: 768px) {
    .tarot-card-container { width: 180px; }
    .tarot-card { height: 320px; }
  }
</style>

<style is:global>
  .spread-card {
    position: absolute;
    width: 56px;
    height: 100px;
    background-image: url('/images/oracles/miroirs-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--gold);
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 60px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 4px rgba(218, 165, 32, 0.15);
  }
  .spread-card:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 12px rgba(218, 165, 32, 0.5);
  }
  .spread-card.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .tr-rev {
    color: var(--orange, #f59e0b);
    font-style: italic;
    font-size: 0.8em;
    margin-left: 0.3em;
  }

  /* ─── Roue verticale (mobile uniquement, ≤640px) ─── */
  #wheel-viewport {
    height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    -webkit-overflow-scrolling: touch;
    perspective: 600px;
    margin: 0 auto;
    max-width: 200px;
  }
  .wheel-card {
    width: 72px;
    height: 100px;
    margin: 10px auto;
    background-image: url('/images/oracles/miroirs-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--gold);
    border-radius: 6px;
    cursor: pointer;
    scroll-snap-align: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    will-change: transform, opacity;
  }
  .wheel-card.selected {
    opacity: 0 !important;
    pointer-events: none;
  }
</style>

<script is:inline src="/js/miroirs-data.js"></script>
<script is:inline src="/js/miroirs-interp.js"></script>
<script is:inline src="/js/miroirs-planes.js"></script>
<script is:inline>
  function initMiroirsSpread() {
    const btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    const MAX_CARDS = 5;
    let selectedCards = [];
    let deckIndices = [];

    const newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', () => {
      newBtnSpread.style.display = 'none';
      const container = document.getElementById('spread-container');
      container.style.display = 'block';

      container.querySelectorAll('.spread-card, #wheel-viewport').forEach(c => c.remove());

      const deckSize = window.miroirsData.length;
      deckIndices = Array.from({length: deckSize}, (_, i) => i).sort(() => 0.5 - Math.random());

      if (window.innerWidth <= 640) {
        buildWheel(container, deckSize);
      } else {
        buildFan(container, deckSize);
      }
    });

    // ─── Desktop : éventail original, inchangé ───
    function buildFan(container, deckSize) {
      void container.offsetWidth;
      const containerWidth = container.offsetWidth > 0 ? container.offsetWidth : Math.min(window.innerWidth - 40, 800);
      const cardWidth = 56;
      const step = (containerWidth - cardWidth) / (deckSize - 1);

      for(let i=0; i<deckSize; i++) {
        const card = document.createElement('div');
        card.className = 'spread-card';
        card.style.left = `${i * step}px`;
        card.style.zIndex = i;

        const middle = (deckSize - 1) / 2;
        const distanceFromCenter = Math.abs(i - middle);
        const yOffset = (distanceFromCenter * distanceFromCenter) * 0.03;
        const rotation = (i - middle) * (40 / deckSize);

        card.style.transform = `translateY(${yOffset}px) rotate(${rotation}deg)`;
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', `Carte ${i + 1} sur ${deckSize}, face cachée`);

        card.addEventListener('click', () => selectCard(card));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCard(card); }
        });
        container.appendChild(card);
      }
    }

    // ─── Mobile : roue verticale 3D (scroll pour parcourir, tap/clavier pour choisir) ───
    function buildWheel(container, deckSize) {
      const viewport = document.createElement('div');
      viewport.id = 'wheel-viewport';

      const spacerH = 90;
      const topSpacer = document.createElement('div');
      topSpacer.style.height = spacerH + 'px';
      viewport.appendChild(topSpacer);

      for (let i = 0; i < deckSize; i++) {
        const card = document.createElement('div');
        card.className = 'wheel-card';
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', `Carte ${i + 1} sur ${deckSize}, face cachée`);
        card.addEventListener('click', () => selectCard(card));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCard(card); }
        });
        viewport.appendChild(card);
      }

      const bottomSpacer = document.createElement('div');
      bottomSpacer.style.height = spacerH + 'px';
      viewport.appendChild(bottomSpacer);

      container.appendChild(viewport);

      let ticking = false;
      function updateTilt() {
        const center = viewport.scrollTop + viewport.clientHeight / 2;
        viewport.querySelectorAll('.wheel-card').forEach(card => {
          const cardCenter = card.offsetTop + card.offsetHeight / 2;
          const norm = Math.max(-1.6, Math.min(1.6, (cardCenter - center) / (viewport.clientHeight / 2)));
          const angle = norm * 55;
          const scale = Math.max(0.55, 1 - Math.abs(norm) * 0.34);
          const opacity = Math.max(0.28, 1 - Math.abs(norm) * 0.6);
          card.style.transform = `rotateX(${angle}deg) scale(${scale})`;
          card.style.opacity = opacity;
        });
        ticking = false;
      }
      viewport.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(updateTilt); ticking = true; }
      }, { passive: true });
      updateTilt();
    }

    function selectCard(cardEl) {
      if(selectedCards.length >= MAX_CARDS) return;
      
      cardEl.classList.add('selected');
      const actualCardData = window.miroirsData[cardEl.dataset.index];
      const reversed = Math.random() < 0.3;
      const cardForSlot = Object.assign({}, actualCardData);
      if(reversed) cardForSlot.isReversed = true;
      selectedCards.push(cardForSlot);
      
      const slotIdx = selectedCards.length;
      const slotFront = document.querySelector(`#slot-${slotIdx} .card-front`);
      if(slotFront) {
        slotFront.classList.remove('empty-slot');
        slotFront.classList.add('filled-slot');
      }
      
      const instr = document.getElementById('instruction-text');
      if(instr) instr.innerText = `Sélectionnez ${MAX_CARDS} cartes (${selectedCards.length}/${MAX_CARDS})`;
      
      if(selectedCards.length === MAX_CARDS) {
        if(instr) instr.innerText = "Tirage complet.";
        setTimeout(() => {
          document.getElementById('deck-area').style.display = 'none';
          document.getElementById('reveal-area').style.display = 'block';
        }, 800);
      }
    }

    const btnReveal = document.getElementById('btn-reveal');
    if (btnReveal) {
      const newBtnReveal = btnReveal.cloneNode(true);
      btnReveal.parentNode.replaceChild(newBtnReveal, btnReveal);
      newBtnReveal.addEventListener('click', () => {
        newBtnReveal.style.display = 'none';

        setTimeout(() => {
          for(let i=1; i<=MAX_CARDS; i++) {
            const cardData = selectedCards[i-1];
            const imgEl = document.getElementById(`img-${i}`);
            const cardNum = cardData.id || i;
            const cardImgBase = `/images/oracles/miroirs/card_${String(cardNum).padStart(2, '0')}`;
            imgEl.src = `${cardImgBase}.webp`;
            imgEl.srcset = `${cardImgBase}-300w.webp 300w, ${cardImgBase}-450w.webp 450w, ${cardImgBase}-600w.webp 600w, ${cardImgBase}.webp 1400w`;
            imgEl.sizes = "(max-width: 768px) 180px, 230px";
            imgEl.alt = cardData.name;
            imgEl.onerror = function() { this.style.display = 'none'; };
            imgEl.style.transform = cardData.isReversed ? 'rotate(180deg)' : '';
            setTimeout(() => {
              document.getElementById(`slot-${i}`).classList.add('flipped');
            }, i * 350);
          }
        }, 100);

        setTimeout(() => {
          const rs = document.getElementById('reading-section');
          if (rs && window.miroirsInterp) {
            rs.innerHTML = window.miroirsInterp.generateReadingWithPlanes('croix', selectedCards);
            setTimeout(function() { initPlaneTabs(); }, 100);
            rs.style.display = 'block';
            rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 3000);
      });
    }
  }

  function initPlaneTabs() {
    document.querySelectorAll('.tr-plane-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        var plane = this.dataset.plane;
        document.querySelectorAll('.tr-plane-tab').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        document.querySelectorAll('.tr-plane-pane').forEach(function(p) { p.classList.remove('active'); });
        var pane = document.querySelector('.tr-plane-pane[data-plane="' + plane + '"]');
        if (pane) pane.classList.add('active');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMiroirsSpread);
  } else {
    initMiroirsSpread();
  }
  document.addEventListener('astro:page-load', initMiroirsSpread);
</script>

</Layout>
