---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Tirage par Mutation — Yi King"
  description="Tirage par mutation du Yi King : hexagramme de départ, traits mutants et hexagramme d'arrivée. Découvrez le mouvement du changement."
  keywords="yi king, i ching, tirage mutation, traits mutants, hexagramme, divination chinoise, livre des mutations"
  canonicalPath="oracles/yi-king/mutation/"
  breadcrumb={[
    { name: "Accueil", item: "https://mysteres.fr/" },
    { name: "Oracles", item: "https://mysteres.fr/oracles/" },
    { name: "Yi King", item: "https://mysteres.fr/oracles/yi-king/" },
    { name: "Tirage par Mutation", item: "https://mysteres.fr/oracles/yi-king/mutation/" }
  ]}
  section="oracles"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/oracles/" style="color:var(--cyan);">Oracles</a> &rsaquo;
  <a href="/oracles/yi-king/" style="color:var(--cyan);">Yi King</a> &rsaquo;
  <span style="color:var(--text);">Tirage par Mutation</span>
</nav>

<main style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;text-align:center;">
  <h1>Tirage par <span class="gold">Mutation</span></h1>
  <p class="subtitle">Le cœur du Yi King : un hexagramme se transforme par mutation de ses traits, révélant le mouvement du changement. Concentrez-vous sur votre question et tirez votre hexagramme.</p>

  <div id="deck-area" style="margin-top:2rem;position:relative;height:280px;display:flex;justify-content:center;align-items:center;">
    <button id="btn-spread" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;z-index:10;">Tirer un hexagramme ✦</button>
    
    <div id="spread-container" style="display:none;position:relative;width:100%;height:100%;max-width:800px;margin:0 auto;">
      <p id="instruction-text" style="position:absolute;top:-40px;width:100%;color:var(--gold);font-weight:bold;font-size:1.1rem;">Sélectionnez votre hexagramme de départ (0/1)</p>
    </div>
  </div>

  <div id="resultats" style="margin-top:3rem;">
    <!-- Hexagramme de départ (slot gauche) -->
    <div style="display:flex;flex-wrap:wrap;gap:2rem;justify-content:center;align-items:flex-start;">
      <div class="hex-card-container" style="width:280px;">
        <div class="hex-pos" style="color:var(--emerald);">Hexagramme de départ</div>
        <div class="hex-card" id="slot-1">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-1" src="" alt="" class="card-img">
              <h3 id="name-1" class="card-name"></h3>
              <p id="meaning-1" class="card-meaning"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Zone de mutation (apparaît après le 1er hexagramme) -->
    <div id="mutation-area" style="display:none;margin-top:3rem;">
      <div class="mutation-arrow">
        <span class="arrow-line">──────</span>
        <span class="arrow-symbol">⚊</span>
        <span class="arrow-label">Trait mutant n°<span id="mutating-line"></span></span>
        <span class="arrow-symbol">⚋</span>
        <span class="arrow-line">──────</span>
      </div>
    </div>

    <!-- Hexagramme d'arrivée (slot droite) -->
    <div style="display:flex;flex-wrap:wrap;gap:2rem;justify-content:center;align-items:flex-start;margin-top:1rem;">
      <div class="hex-card-container" id="arriving-container" style="display:none;width:280px;">
        <div class="hex-pos" style="color:var(--rose);">Hexagramme d'arrivée</div>
        <div class="hex-card" id="slot-2">
          <div class="card-inner">
            <div class="card-front empty-slot-2"></div>
            <div class="card-back">
              <img id="img-2" src="" alt="" class="card-img">
              <h3 id="name-2" class="card-name"></h3>
              <p id="meaning-2" class="card-meaning"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div id="reveal-area" style="display:none;margin-top:2rem;">
      <button id="btn-reveal" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;">Révéler la mutation ✦</button>
    </div>

    <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

    <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);">Le Yi King révèle le mouvement du changement. Chaque mutation est une invitation à danser avec le flux de la vie.</p>
  </div>
</main>

<style>
  .hex-card-container { width: 280px; }
  .hex-pos { font-family: var(--font-mono); font-size: 0.85rem; color: var(--gold); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
  .hex-card { width: 100%; height: 340px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .hex-card.flipped .card-inner { transform: rotateY(180deg); }
  
  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--gold); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 0.6rem; }
  
  .card-front { 
    background-image: url('/images/oracles/yi-king-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center;
  }
  
  .empty-slot, .empty-slot-2 {
    background: rgba(218, 165, 32, 0.03);
    background-image: none;
    border: 2px dashed rgba(218, 165, 32, 0.4);
  }
  .filled-slot {
    background-image: url('/images/oracles/yi-king-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--gold);
    box-shadow: 0 0 12px rgba(218, 165, 32, 0.4);
  }
  .filled-slot-2 {
    background-image: url('/images/oracles/yi-king-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--rose);
    box-shadow: 0 0 14px rgba(232, 121, 130, 0.5);
  }
  
  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow: hidden; justify-content: flex-start; align-items: center; gap: 0.4rem; }
  .card-img { width: 180px; height: auto; margin-top: 0.5rem; object-fit: contain; }
  .card-name { color: var(--gold); font-size: 0.95rem; margin: 0.2rem 0; padding: 0; width: 100%; text-align: center; }
  .card-meaning { font-size: 0.72rem; line-height: 1.45; color: var(--text-muted); text-align: center; padding: 0 0.4rem; overflow-y: auto; max-height: 80px; }

  .mutation-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 1rem;
    font-family: var(--font-mono);
  }
  .arrow-line { color: var(--gold); opacity: 0.6; font-size: 1.2rem; }
  .arrow-symbol { color: var(--gold); font-size: 2rem; }
  .arrow-label { color: var(--orange); font-size: 0.9rem; font-weight: bold; }

  @media (max-width: 768px) {
    .hex-card-container { width: 230px; }
    .hex-card { height: 300px; }
    .card-img { width: 160px; }
  }
</style>

<style is:global>
  .spread-card-yk-m {
    position: absolute;
    width: 52px;
    height: 72px;
    background-image: url('/images/oracles/yi-king-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--gold);
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 90px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 6px rgba(218, 165, 32, 0.2);
  }
  .spread-card-yk-m:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 14px rgba(218, 165, 32, 0.6);
  }
  .spread-card-yk-m.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>

<script is:inline src="/js/yi-king-data.js"></script>
<script is:inline src="/js/yi-king-interp.js"></script>
<script is:inline src="/js/yi-king-planes.js"></script>
<script is:inline>
  function initMutationTirage() {
    const btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    let selectedCards = [];  // [startingHexagram, arrivingHexagram]
    let mutatingLine = 0;
    let deckIndices = [];

    const newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', () => {
      newBtnSpread.style.display = 'none';
      const container = document.getElementById('spread-container');
      container.style.display = 'block';
      
      container.querySelectorAll('.spread-card-yk-m').forEach(c => c.remove());
      
      const deckSize = window.yiKingData.length;
      deckIndices = Array.from({length: deckSize}, (_, i) => i).sort(() => 0.5 - Math.random());
      
      void container.offsetWidth;
      const containerWidth = container.offsetWidth > 0 ? container.offsetWidth : Math.min(window.innerWidth - 40, 800);
      const cardWidth = 52;
      const step = (containerWidth - cardWidth) / (deckSize - 1);
      
      for(let i=0; i<deckSize; i++) {
        const card = document.createElement('div');
        card.className = 'spread-card-yk-m';
        card.style.left = `${i * step}px`;
        card.style.zIndex = i;
        
        const middle = (deckSize - 1) / 2;
        const distanceFromCenter = Math.abs(i - middle);
        const yOffset = (distanceFromCenter * distanceFromCenter) * 0.03;
        const rotation = (i - middle) * (40 / deckSize);
        
        card.style.transform = `translateY(${yOffset}px) rotate(${rotation}deg)`;
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        
        card.addEventListener('click', () => selectCard(card));
        container.appendChild(card);
      }
    });

    function selectCard(cardEl) {
      if(selectedCards.length >= 1) return;
      
      cardEl.classList.add('selected');
      const actualCardData = window.yiKingData[cardEl.dataset.index];
      selectedCards.push(actualCardData);
      
      const slotFront = document.querySelector('#slot-1 .card-front');
      if(slotFront) {
        slotFront.classList.remove('empty-slot');
        slotFront.classList.add('filled-slot');
      }
      
      // Générer le trait mutant (ligne 1 à 6) et l'hexagramme d'arrivée
      mutatingLine = Math.floor(Math.random() * 6) + 1;
      
      // L'hexagramme d'arrivée = même id + offset basé sur la ligne mutante
      // Pour simuler: on prend un hexagramme adjacent dans la liste
      var startIdx = window.yiKingData.indexOf(actualCardData);
      var endIdx = (startIdx + mutatingLine + Math.floor(Math.random() * 3 + 1)) % 64;
      var arrivingHex = window.yiKingData[endIdx];
      selectedCards.push(arrivingHex);
      
      document.getElementById('mutating-line').textContent = mutatingLine;
      
      // Marquer le slot 2 comme rempli
      const slotFront2 = document.querySelector('#slot-2 .card-front');
      if(slotFront2) {
        slotFront2.classList.remove('empty-slot-2');
        slotFront2.classList.add('filled-slot-2');
      }
      
      const instr = document.getElementById('instruction-text');
      if(instr) instr.innerText = "Hexagramme sélectionné. La mutation opère...";
      
      setTimeout(() => {
        document.getElementById('deck-area').style.display = 'none';
        document.getElementById('mutation-area').style.display = 'block';
        document.getElementById('arriving-container').style.display = 'block';
        document.getElementById('reveal-area').style.display = 'block';
      }, 800);
    }

    const btnReveal = document.getElementById('btn-reveal');
    if (btnReveal) {
      const newBtnReveal = btnReveal.cloneNode(true);
      btnReveal.parentNode.replaceChild(newBtnReveal, btnReveal);
      newBtnReveal.addEventListener('click', () => {
        newBtnReveal.style.display = 'none';

        // Afficher l'hexagramme de départ
        setTimeout(() => {
          const cardData1 = selectedCards[0];
          const imgEl1 = document.getElementById('img-1');
          const nameEl1 = document.getElementById('name-1');
          const meaningEl1 = document.getElementById('meaning-1');
          const cardId1 = String(cardData1.id).padStart(2, '0');
          imgEl1.src = `/images/oracles/yi-king/hexagramme-${cardId1}.svg`;
          imgEl1.onerror = function() { this.style.display = 'none'; };
          if (nameEl1) nameEl1.textContent = cardData1.name;
          if (meaningEl1) meaningEl1.textContent = cardData1.theme;
          document.getElementById('slot-1').classList.add('flipped');
        }, 100);

        // Afficher l'hexagramme d'arrivée
        setTimeout(() => {
          const cardData2 = selectedCards[1];
          const imgEl2 = document.getElementById('img-2');
          const nameEl2 = document.getElementById('name-2');
          const meaningEl2 = document.getElementById('meaning-2');
          const cardId2 = String(cardData2.id).padStart(2, '0');
          imgEl2.src = `/images/oracles/yi-king/hexagramme-${cardId2}.svg`;
          imgEl2.onerror = function() { this.style.display = 'none'; };
          if (nameEl2) nameEl2.textContent = cardData2.name;
          if (meaningEl2) meaningEl2.textContent = cardData2.theme;
          document.getElementById('slot-2').classList.add('flipped');
        }, 700);

        // Générer la lecture
        setTimeout(() => {
          const rs = document.getElementById('reading-section');
          if (rs && window.yiKingInterp) {
            // Pour l'interpréteur, on passe les 2 hexagrammes + le trait mutant
            var cardsWithMutation = [{hex: selectedCards[0], mutatingLine: mutatingLine}, {hex: selectedCards[1], mutatingLine: mutatingLine}];
            rs.innerHTML = window.yiKingInterp.generateReadingWithPlanes('mutation', selectedCards, { mutatingLine: mutatingLine });
            setTimeout(function() { initPlaneTabs(); }, 100);
            rs.style.display = 'block';
            rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 2000);
      });
    }
  }

  function initPlaneTabs() {
    document.querySelectorAll('.tr-plane-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        var plane = this.dataset.plane;
        document.querySelectorAll('.tr-plane-tab').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        document.querySelectorAll('.tr-plane-pane').forEach(function(p) { p.classList.remove('active'); });
        var pane = document.querySelector('.tr-plane-pane[data-plane="' + plane + '"]');
        if (pane) pane.classList.add('active');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMutationTirage);
  } else {
    initMutationTirage();
  }
  document.addEventListener('astro:page-load', initMutationTirage);
</script>

</Layout>
