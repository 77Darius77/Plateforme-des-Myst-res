---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Oracles — Plateforme des Mystères",
  "url": "https://plateforme-des-mysteres.com/oracles/",
  "description": "Découvrez les différents arts divinatoires : Oracle de Belline, Oracle Gé, Géomancie classique, Oracle de la Triade, Oracle des Miroirs, Runes nordiques et Yi King.",
  "inLanguage": "fr",
  "about": {
    "@type": "Thing",
    "name": "Oracles"
  }
};
---

<Layout
  title="Oracles — Plateforme des Mystères"
  description="Découvrez les 7 arts divinatoires : Oracle de Belline, Oracle Gé, Géomancie classique, Oracle de la Triade, Oracle des Miroirs, Runes nordiques et Yi King. Gratuit, sans tracking."
  keywords="oracles, belline, géomancie, triade, runes, yi king, divination, arts divinatoires"
  canonicalPath="oracles/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Oracles", item: "https://plateforme-des-mysteres.com/oracles/" }
  ]}
  section="oracles"
>


<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <span style="color:var(--text);">Oracles</span>
</nav>

<div class="hub-container">
  <!-- Sidebar d'Introduction -->
  <aside class="hub-sidebar">
    <h1>
      <span class="pulse"></span>
      🔮 <span class="gold">Oracles</span><br>Les arts <span class="emerald">divinatoires</span>
    </h1>
    <p class="subtitle">
      Sept traditions pour éclairer votre chemin.
      De l'Oracle de Belline à la Géomancie classique, chaque art offre une voie unique
      pour recevoir guidance et inspiration au quotidien.
    </p>
    <div class="quote">
      « L'oracle ne prédit pas l'avenir, il éclaire le présent. »
      <br><span class="gold">— Sagesse ancestrale</span>
    </div>
  </aside>

  <!-- Grille des Oracles -->
  <main class="hub-main">
    <div class="section-title">
        <div class="num">[ 01 ]</div>
        <h2>✦ Les 7 Oracles</h2>
      <p class="slate">Choisis l'art divinatoire qui résonne avec ton cheminement intérieur.</p>
    </div>

    <div class="mystere-grid">

      <!-- Carte 1 : Oracle de Belline -->
      <div class="mystere-card" style="--card-accent-color: var(--gold); --hover-accent-color: var(--gold);">
        <div class="card-icon">🔮</div>
        <h3>ORACLE DE BELLINE</h3>
        <p>
          53 cartes d'une grande précision divinatoire. Créé par le voyant Edmond
          dans les années 1960, c'est l'oracle de prédilection des cartomanciens.
        </p>
        <a href="/oracles/belline/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

      <!-- Carte 2 : Oracle Gé (Géomancie) -->
      <div class="mystere-card" style="--card-accent-color: var(--emerald); --hover-accent-color: var(--emerald);">
        <div class="card-icon">🌍</div>
        <h3>ORACLE GÉ</h3>
        <p>
          La géomancie, art millénaire des figures. Interprétation des 16 figures
          géomantiques issues de la terre, pratiquée depuis le Moyen Âge.
        </p>
        <a href="/oracles/ge/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

      <!-- Carte 3 : Géomancie Classique -->
      <div class="mystere-card" style="--card-accent-color: var(--gold); --hover-accent-color: var(--gold);">
        <div class="card-icon">🪨</div>
        <h3>GÉOMANCIE</h3>
        <p>
          Seize figures binaires nées de la tradition arabe <em>Ilm al-Raml</em>. Codifiée par Agrippa
          et Fludd, la géomancie classique offre trois méthodes de tirage pour explorer passé, présent et futur.
        </p>
        <a href="/oracles/geomancie/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

      <!-- Carte 4 : Oracle de la Triade -->
      <div class="mystere-card" style="--card-accent-color: var(--cyan); --hover-accent-color: var(--cyan);">
        <div class="card-icon">🔺</div>
        <h3>ORACLE DE LA TRIADE</h3>
        <p>
          57 cartes inspirées de l'ésotérisme égyptien et universel. Créé par Dominique Duplaa,
          cet oracle puissant guide de la matière vers l'esprit, d'Alpha à Oméga.
        </p>
        <a href="/oracles/triade/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

      <!-- Carte 5 : Oracle des Miroirs -->
      <div class="mystere-card" style="--card-accent-color: var(--violet); --hover-accent-color: var(--violet);">
        <div class="card-icon">🪞</div>
        <h3>ORACLE DES MIROIRS</h3>
        <p>
          53 cartes psychanalytiques et intuitives créées par Dimitri d'Alfange d'Uvril.
          Chaque carte est un miroir de l'âme pour une introspection profonde et bienveillante.
        </p>
        <a href="/oracles/miroirs/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

      <!-- Carte 6 : Runes nordiques -->
      <div class="mystere-card" style="--card-accent-color: var(--violet); --hover-accent-color: var(--violet);">
        <div class="card-icon">ᚱ</div>
        <h3>RUNES NORDIQUES</h3>
        <p>
          L'alphabet sacré Futhark découvert par Odin. 24 runes mêlant psychanalyse
          et intuition pour une divination puissante inspirée des traditions nordiques.
        </p>
        <a href="/oracles/runes/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

      <!-- Carte 7 : Yi King -->
      <div class="mystere-card" style="--card-accent-color: var(--rose); --hover-accent-color: var(--rose);">
        <div class="card-icon">☯</div>
        <h3>YI KING</h3>
        <p>
          Le Livre des Mutations, 64 hexagrammes. La plus ancienne méthode divinatoire
          chinoise, offrant une sagesse intemporelle pour naviguer le changement.
        </p>
        <a href="/oracles/yi-king/" class="btn-explore">Découvrir l'Oracle ✦</a>
      </div>

    </div>
  </main>
</div>

  <p slot="sources" style="color:#64748b;font-size:0.75rem;margin-bottom:0.8rem;">
    Sources : Oracle de Belline (Edmond), Oracle Gé, Géomancie (Ilm al-Raml / Agrippa), Oracle de la Triade (Dominique Duplaa), Oracle des Miroirs (Dimitri d'Alfange d'Uvril / Aurore Schmitt), Runes (Futhark ancien), Yi King (Livre des Mutations)
  </p>

</Layout>
