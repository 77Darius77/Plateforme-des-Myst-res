---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Tirage des Nornes (3 Runes) — Runes Nordiques"
  description="Effectuez un tirage gratuit des 3 Nornes avec les Runes Nordiques du Futhark Ancien. Passé, Présent, Futur — les trois déesses tissent votre destinée."
  keywords="runes, tirage nornes, 3 runes, urðr, verðandi, skuld, divination nordique, futhark"
  canonicalPath="oracles/runes/trois-runes/"
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Oracles", item: "https://plateforme-des-mysteres.com/oracles/" },
    { name: "Runes Nordiques", item: "https://plateforme-des-mysteres.com/oracles/runes/" },
    { name: "Tirage des Nornes", item: "https://plateforme-des-mysteres.com/oracles/runes/trois-runes/" }
  ]}
  section="oracles"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/oracles/" style="color:var(--cyan);">Oracles</a> &rsaquo;
  <a href="/oracles/runes/" style="color:var(--cyan);">Runes Nordiques</a> &rsaquo;
  <span style="color:var(--text);">Tirage des Nornes</span>
</nav>

<main style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;text-align:center;">
  <h1>Tirage des <span class="gold">Nornes</span> <span style="font-size:1.5rem;">ᚱᚱᚱ</span></h1>
  <p class="subtitle">Concentrez-vous sur votre question. Les trois Nornes — Urðr, Verðandi et Skuld — vont tisser votre réponse. Choisissez 3 runes.</p>

  <div id="deck-area" style="margin-top:2rem;position:relative;height:250px;display:flex;justify-content:center;align-items:center;">
    <button id="btn-spread" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;z-index:10;">Étaler les runes ᚱ</button>
    
    <div id="spread-container" style="display:none;position:relative;width:100%;height:100%;max-width:800px;margin:0 auto;">
      <p id="instruction-text" style="position:absolute;top:-40px;width:100%;color:var(--gold-text);font-weight:bold;font-size:1.1rem;">Sélectionnez 3 runes (0/3)</p>
    </div>
  </div>

  <div id="resultats" style="margin-top:3rem;">
    <div style="display:flex;flex-wrap:wrap;gap:2rem;justify-content:center;">
      <div class="tarot-card-container">
        <div class="tarot-pos">1. Urðr — Le Passé</div>
        <div class="tarot-card" id="slot-1">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-1" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>

      <div class="tarot-card-container">
        <div class="tarot-pos">2. Verðandi — Le Présent</div>
        <div class="tarot-card" id="slot-2">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-2" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>

      <div class="tarot-card-container">
        <div class="tarot-pos">3. Skuld — Le Futur</div>
        <div class="tarot-card" id="slot-3">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-3" src="" alt="" loading="lazy" class="card-img">
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div id="reveal-area" style="display:none;margin-top:2rem;">
      <button id="btn-reveal" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;">Révéler le tirage ᚱ</button>
    </div>

    <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

    <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);">Les runes éclairent, elles ne contraignent pas. Le libre arbitre reste la rune suprême.</p>
  </div>

  <div style="max-width:720px;margin:3rem auto 1rem;text-align:left;padding:0 1rem;"><h2 style="font-size:1.3rem;color:var(--gold-text);margin-bottom:1rem;">Les Runes — l'alphabet sacré nordique</h2><p style="color:var(--text-dim);line-height:1.8;margin-bottom:1rem;">Le Futhark Ancien (24 runes) fut utilisé du IIᵉ au VIIIᵉ siècle. Odin découvrit les runes après neuf nuits pendu à Yggdrasil. Le tirage des Nornes s'inspire des trois déesses du destin : <strong>Urðr</strong> (passé), <strong>Verðandi</strong> (présent) et <strong>Skuld</strong> (futur).</p><p style="color:var(--text-dim);line-height:1.8;">Les runes ne répondent pas par oui ou non — elles révèlent les forces qui traversent votre situation.</p></div>
</main>

<style>
  .tarot-card-container { width: 252px; }
  .tarot-pos { font-family: var(--font-mono); font-size: 0.85rem; color: var(--gold-text); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
  .tarot-card { width: 100%; height: 460px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .tarot-card.flipped .card-inner { transform: rotateY(180deg); }
  
  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--gold); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 0.6rem; }
  
  .card-front { 
    background-image: url('/images/oracles/runes-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center;
  }
  
  .empty-slot {
    background: rgba(218, 165, 32, 0.03);
    background-image: none;
    border: 2px dashed rgba(218, 165, 32, 0.4);
  }
  .filled-slot {
    background-image: url('/images/oracles/runes-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--gold);
    box-shadow: 0 0 8px rgba(218, 165, 32, 0.3);
  }
  
  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow: hidden; justify-content: center; align-items: center; padding: 0; }
  .card-img { width: 100%; height: auto; max-height: 100%; border-radius: 4px; object-fit: contain; margin: 0; }

  @media (max-width: 768px) {
    .tarot-card-container { width: 214px; }
    .tarot-card { height: 400px; }
  }
</style>

<style is:global>
  .spread-card {
    position: absolute;
    width: 56px;
    height: 100px;
    background-image: url('/images/oracles/runes-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--gold);
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 60px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 4px rgba(218, 165, 32, 0.15);
  }
  .spread-card:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 12px rgba(218, 165, 32, 0.5);
  }
  .spread-card.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* ─── Roue verticale (mobile uniquement, ≤640px) ─── */
  #wheel-viewport {
    height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    -webkit-overflow-scrolling: touch;
    perspective: 600px;
    margin: 0 auto;
    max-width: 200px;
  }
  .wheel-card {
    width: 56px;
    height: 100px;
    margin: 10px auto;
    background-image: url('/images/oracles/runes-card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid var(--gold);
    border-radius: 6px;
    cursor: pointer;
    scroll-snap-align: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    will-change: transform, opacity;
  }
  .wheel-card.selected {
    opacity: 0 !important;
    pointer-events: none;
  }
  .tr-rev {
    color: #f59e0b;
    font-style: italic;
    font-size: 0.8em;
    margin-left: 0.3em;
  }
</style>

<script is:inline src="/js/runes-data.js"></script>
<script is:inline src="/js/runes-interp.js"></script>
<script is:inline src="/js/runes-planes.js"></script>
<script is:inline>
  function initRuneSpread() {
    var btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    var MAX_CARDS = 3;
    var selectedCards = [];
    var deckIndices = [];

    var newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', function() {
      newBtnSpread.style.display = 'none';
      var container = document.getElementById('spread-container');
      container.style.display = 'block';

      container.querySelectorAll('.spread-card, #wheel-viewport').forEach(function(c) { c.remove(); });

      var deckSize = window.runesData.length;
      deckIndices = Array.from({length: deckSize}, function(_, i) { return i; }).sort(function() { return 0.5 - Math.random(); });

      if (window.innerWidth <= 640) {
        buildWheel(container, deckSize);
      } else {
        buildFan(container, deckSize);
      }
    });

    // ─── Desktop : éventail original, inchangé ───
    function buildFan(container, deckSize) {
      void container.offsetWidth;
      var containerWidth = container.offsetWidth > 0 ? container.offsetWidth : Math.min(window.innerWidth - 40, 800);
      var cardWidth = 56;
      var step = (containerWidth - cardWidth) / (deckSize - 1);

      for (var i = 0; i < deckSize; i++) {
        var card = document.createElement('div');
        card.className = 'spread-card';
        card.style.left = (i * step) + 'px';
        card.style.zIndex = i;

        var middle = (deckSize - 1) / 2;
        var distanceFromCenter = Math.abs(i - middle);
        var yOffset = (distanceFromCenter * distanceFromCenter) * 0.03;
        var rotation = (i - middle) * (40 / deckSize);

        card.style.transform = 'translateY(' + yOffset + 'px) rotate(' + rotation + 'deg)';
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', 'Carte ' + (i + 1) + ' sur ' + deckSize + ', face cachée');

        card.addEventListener('click', function() { selectCard(this); });
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCard(this); }
        });
        container.appendChild(card);
      }
    }

    // ─── Mobile : roue verticale 3D (scroll pour parcourir, tap/clavier pour choisir) ───
    function buildWheel(container, deckSize) {
      var viewport = document.createElement('div');
      viewport.id = 'wheel-viewport';

      var spacerH = 90;
      var topSpacer = document.createElement('div');
      topSpacer.style.height = spacerH + 'px';
      viewport.appendChild(topSpacer);

      for (var i = 0; i < deckSize; i++) {
        var card = document.createElement('div');
        card.className = 'wheel-card';
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', 'Carte ' + (i + 1) + ' sur ' + deckSize + ', face cachée');
        card.addEventListener('click', function() { selectCard(this); });
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCard(this); }
        });
        viewport.appendChild(card);
      }

      var bottomSpacer = document.createElement('div');
      bottomSpacer.style.height = spacerH + 'px';
      viewport.appendChild(bottomSpacer);

      container.appendChild(viewport);

      var ticking = false;
      function updateTilt() {
        var center = viewport.scrollTop + viewport.clientHeight / 2;
        viewport.querySelectorAll('.wheel-card').forEach(function(card) {
          var cardCenter = card.offsetTop + card.offsetHeight / 2;
          var norm = Math.max(-1.6, Math.min(1.6, (cardCenter - center) / (viewport.clientHeight / 2)));
          var angle = norm * 55;
          var scale = Math.max(0.55, 1 - Math.abs(norm) * 0.34);
          var opacity = Math.max(0.28, 1 - Math.abs(norm) * 0.6);
          card.style.transform = 'rotateX(' + angle + 'deg) scale(' + scale + ')';
          card.style.opacity = opacity;
        });
        ticking = false;
      }
      viewport.addEventListener('scroll', function() {
        if (!ticking) { requestAnimationFrame(updateTilt); ticking = true; }
      }, { passive: true });
      updateTilt();
    }

    function selectCard(cardEl) {
      if (selectedCards.length >= MAX_CARDS) return;
      
      cardEl.classList.add('selected');
      var actualCardData = window.runesData[cardEl.dataset.index];
      var cardCopy = Object.assign({}, actualCardData);
      cardCopy.isReversed = cardCopy.canReverse && Math.random() < 0.25;
      selectedCards.push(cardCopy);
      
      var slotIdx = selectedCards.length;
      var slotFront = document.querySelector('#slot-' + slotIdx + ' .card-front');
      if (slotFront) {
        slotFront.classList.remove('empty-slot');
        slotFront.classList.add('filled-slot');
      }
      
      var instr = document.getElementById('instruction-text');
      if (instr) instr.innerText = 'Sélectionnez ' + MAX_CARDS + ' runes (' + selectedCards.length + '/' + MAX_CARDS + ')';
      
      if (selectedCards.length === MAX_CARDS) {
        if (instr) instr.innerText = "Tirage complet — les Nornes ont parlé.";
        setTimeout(function() {
          document.getElementById('deck-area').style.display = 'none';
          document.getElementById('reveal-area').style.display = 'block';
        }, 800);
      }
    }

    var btnReveal = document.getElementById('btn-reveal');
    if (btnReveal) {
      var newBtnReveal = btnReveal.cloneNode(true);
      btnReveal.parentNode.replaceChild(newBtnReveal, btnReveal);
      newBtnReveal.addEventListener('click', function() {
        newBtnReveal.style.display = 'none';

        setTimeout(function() {
          for (var i = 1; i <= MAX_CARDS; i++) {
            (function(idx) {
              var cardData = selectedCards[idx - 1];
              var imgEl = document.getElementById('img-' + idx);
              var cardNum = cardData.id;
              imgEl.src = '/images/oracles/runes/rune_' + String(cardNum).padStart(2, '0') + '.svg';
              imgEl.alt = cardData.name;
              imgEl.onerror = function() { this.style.display = 'none'; };
              setTimeout(function() {
                var slot = document.getElementById('slot-' + idx);
                if (cardData.isReversed && cardData.canReverse) {
                  slot.style.transform = 'rotate(180deg)';
                }
                slot.classList.add('flipped');
              }, idx * 350);
            })(i);
          }
        }, 100);

        setTimeout(function() {
          var rs = document.getElementById('reading-section');
          if (rs && window.runesInterp) {
            rs.innerHTML = window.runesInterp.generateReadingWithPlanes('trois-runes', selectedCards);
            setTimeout(function() { initPlaneTabs(); }, 100);
            rs.style.display = 'block';
            rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 2000);
      });
    }
  }

  function initPlaneTabs() {
    document.querySelectorAll('.tr-plane-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        var plane = this.dataset.plane;
        document.querySelectorAll('.tr-plane-tab').forEach(function(t) { t.classList.remove('active'); t.style.color = 'var(--text-muted)'; });
        this.classList.add('active');
        this.style.color = 'var(--gold)';
        document.querySelectorAll('.tr-plane-pane').forEach(function(p) { p.classList.remove('active'); p.style.display = 'none'; });
        var pane = document.querySelector('.tr-plane-pane[data-plane="' + plane + '"]');
        if (pane) { pane.classList.add('active'); pane.style.display = 'block'; }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRuneSpread);
  } else {
    initRuneSpread();
  }
  document.addEventListener('astro:page-load', initRuneSpread);
</script>

</Layout>
