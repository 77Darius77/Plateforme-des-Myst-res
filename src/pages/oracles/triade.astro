---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Oracle de la Triade — 57 Cartes | Plateforme des Mystères",
  "url": "https://plateforme-des-mysteres.com/oracles/triade/",
  "description": "Oracle de la Triade : 57 cartes d'inspiration égyptienne et ésotérique. Tirages gratuits en Croix, 3 Cartes et Pyramide (Tétraktys). Interprétations détaillées.",
  "inLanguage": "fr"
};
---

<Layout
  title="Oracle de la Triade — 57 Cartes d'Inspiration Égyptienne | Plateforme des Mystères"
  description="Oracle de la Triade : 57 cartes ésotériques. Tirages gratuits en Croix, 3 Cartes et Pyramide (Tétraktys). Interprétations personnalisées sur 3 plans."
  keywords="oracle de la triade, triade oracle, dominique duplaa, cartomancie, tirage triade, tétraktys, pyramide, ésotérisme égyptien"
  canonicalPath="oracles/triade/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Oracles", item: "https://plateforme-des-mysteres.com/oracles/" },
    { name: "Oracle de la Triade", item: "https://plateforme-des-mysteres.com/oracles/triade/" }
  ]}
  section="oracles"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/oracles/" style="color:var(--cyan);">Oracles</a> &rsaquo;
  <span style="color:var(--text);">Oracle de la Triade</span>
</nav>

<main style="max-width:900px;margin:0 auto;padding:1.5rem;">
  <header style="text-align:center;margin-bottom:2.5rem;">
    <div style="font-size:2.5rem;margin-bottom:0.5rem;">🔺</div>
    <h1 style="font-family:var(--font-display);font-size:2.2rem;margin:0 0 0.5rem;">
      <span class="gold">Oracle de la Triade</span>
    </h1>
    <p style="color:var(--cyan);font-family:var(--font-mono);font-size:0.9rem;letter-spacing:1px;">D'ALPHA À OMÉGA — 57 CARTES POUR ÉCLAIRER VOTRE CHEMIN</p>
    <p style="color:var(--text-muted);max-width:650px;margin:1.2rem auto 0;line-height:1.7;font-size:0.95rem;">
      Créé par <strong>Dominique Duplaa</strong> et illustré par Sylvie Breysse, l'Oracle de la Triade
      puise ses racines dans l'ésotérisme occidental, la kabbale, l'alchimie et les philosophies orientales.
      Ses 57 lames tracent un chemin initiatique de la matière à l'esprit, d'Alpha à Oméga.
    </p>
    <blockquote style="margin:1.5rem auto 0;max-width:500px;font-style:italic;color:var(--cyan);font-size:0.9rem;border-left:3px solid var(--cyan);padding-left:1rem;">
      « La Triade ne prédit pas — elle révèle ce qui est déjà en vous. »
    </blockquote>
  </header>

  <div class="section-title" style="text-align:center;margin-bottom:2rem;">
    <div class="num" style="color:var(--cyan);">[ △ ]</div>
    <h2 style="color:var(--gold-text);">✦ Choisissez votre tirage</h2>
    <p class="slate" style="color:var(--text-muted);">Trois configurations pour explorer les messages de la Triade.</p>
  </div>

  <div class="mystere-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-bottom:3rem;">

    <div class="mystere-card" style="--card-accent-color:var(--cyan);--hover-accent-color:var(--cyan);">
      <div class="card-icon" style="font-size:1.5rem;">☥</div>
      <h3>TIRAGE À 3 CARTES</h3>
      <p>
        Passé, Présent, Futur — un éclairage simple et direct sur votre situation.
        Idéal pour une question précise ou un état des lieux rapide.
      </p>
      <a href="/oracles/triade/trois-cartes/" class="btn-explore">Effectuer ce tirage ✦</a>
    </div>

    <div class="mystere-card" style="--card-accent-color:var(--cyan);--hover-accent-color:var(--cyan);">
      <div class="card-icon" style="font-size:1.5rem;">⊕</div>
      <h3>TIRAGE EN CROIX</h3>
      <p>
        Analyse approfondie en 5 positions : Forces, Obstacles, Environnement, Résultat et Synthèse.
        Le tirage classique pour décrypter une situation complexe.
      </p>
      <a href="/oracles/triade/croix/" class="btn-explore">Effectuer ce tirage ✦</a>
    </div>

    <div class="mystere-card" style="--card-accent-color:var(--cyan);--hover-accent-color:var(--cyan);">
      <div class="card-icon" style="font-size:1.5rem;">🔺</div>
      <h3>TIRAGE PYRAMIDE</h3>
      <p>
        La Tétraktys sacrée — 10 cartes réparties en 4 niveaux : Spirituel, Idées, Action, Concret.
        Pour une vision complète de votre cheminement.
      </p>
      <a href="/oracles/triade/pyramide/" class="btn-explore">Effectuer ce tirage ✦</a>
    </div>

  </div>

  <section style="background:rgba(var(--cyan-rgb),0.04);border:1px solid rgba(var(--cyan-rgb),0.15);border-radius:12px;padding:1.8rem;max-width:700px;margin:0 auto;">
    <h3 style="color:var(--cyan);font-size:1.2rem;margin-bottom:1rem;">★ Fondements de l'Oracle de la Triade</h3>
    <ul style="color:var(--text-muted);line-height:1.8;font-size:0.9rem;list-style:none;padding:0;">
      <li>🔹 <strong>Ésotérisme occidental</strong> : alchimie, kabbale, numérologie</li>
      <li>🔹 <strong>Philosophies orientales</strong> : yin/yang, karma, réincarnation</li>
      <li>🔹 <strong>Symbolisme universel</strong> : croix, triangle, nombres sacrés</li>
      <li>🔹 <strong>Progression Alpha → Oméga</strong> : de la genèse à l'accomplissement</li>
      <li>🔹 <strong>57 lames</strong> : un voyage complet de la matière à l'esprit</li>
    </ul>
  </section>

  <p style="text-align:center;margin-top:2.5rem;font-style:italic;color:var(--text-muted);font-size:0.85rem;">
    L'Oracle de la Triade est un outil de guidance. Le libre arbitre reste votre meilleur guide.
  </p>
</main>

<style>
  .btn-explore {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.6rem 1.4rem;
    background: transparent;
    border: 1px solid var(--card-accent-color);
    color: var(--card-accent-color);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }
  .btn-explore:hover {
    background: var(--card-accent-color);
    color: var(--bg-deep);
  }
</style>

</Layout>
