---
import Layout from '../layouts/Layout.astro';

const GUMROAD_URL = "https://mystereplateform.gumroad.com/l/LES-22-ARCHETYPES";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Les 22 Archétypes — Tarot · Numérologie · Psyché",
  "description": "Guide complet de 22 fiches combinant Tarot de Marseille, numérologie et archétypes de Jung. Méditations guidées, exercices de journaling, calcul de votre Arcane Personnel.",
  "url": "https://plateforme-des-mysteres.com/boutique/",
  "image": "https://plateforme-des-mysteres.com/og-boutique.jpg",
  "brand": { "@type": "Brand", "name": "Plateforme des Mystères" },
  "offers": {
    "@type": "Offer",
    "price": "7.00",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "url": GUMROAD_URL
  }
};
---

<Layout
  title="Boutique — Les 22 Archétypes | Plateforme des Mystères"
  description="Guide PDF premium : 22 fiches Tarot de Marseille · Numérologie · Archétypes de Jung. Méditations, journaling, Arcane Personnel. Téléchargement immédiat."
  keywords="tarot marseille guide, numérologie archétypes, jung tarot, guide ésotérisme, pdf tarot"
  canonicalPath="boutique/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Boutique", item: "https://plateforme-des-mysteres.com/boutique/" }
  ]}
>

<!-- Hero -->
<section id="boutique-hero">
  <div class="hero-badge">
    <span class="badge-dot"></span>
    Guide PDF · Téléchargement immédiat
  </div>
  <h1>
    <span class="gold">Les 22 Archétypes</span>
  </h1>
  <p class="hero-sub">Tarot de Marseille &nbsp;·&nbsp; Numérologie &nbsp;·&nbsp; Psyché de Jung</p>
  <p class="hero-desc">
    Un guide de transformation intérieure — pas un simple manuel d'interprétation.<br>
    22 fiches complètes pour explorer les visages universels de l'âme humaine.
  </p>
  <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn-primary">
    ✦ Télécharger le guide — 7 €
  </a>
  <p class="hero-notice">Paiement sécurisé via Gumroad · PDF haute qualité</p>
</section>

<!-- Aperçu produit -->
<section id="product-showcase">
  <div class="showcase-grid">

    <!-- Image couverture -->
    <div class="showcase-cover">
      <div class="cover-frame">
        <img
          src="/images/cover-22-archetypes.png"
          alt="Couverture du guide Les 22 Archétypes — Tarot · Numérologie · Psyché"
          class="cover-img"
          width="549"
          height="777"
        />
      </div>
      <div class="cover-meta">
        <span>~70 pages</span>
        <span>·</span>
        <span>Format A4</span>
        <span>·</span>
        <span>Imprimable</span>
      </div>
    </div>

    <!-- Contenu -->
    <div class="showcase-content">
      <h2>Ce que contient le guide</h2>
      <p class="showcase-intro">
        Pour chacun des 22 Arcanes Majeurs du Tarot de Marseille (deck Nicolas Conver 1760) :
      </p>

      <ul class="feature-list">
        <li><span class="feat-icon">✦</span><div><strong>Vibration numérologique</strong> — le sens profond du nombre associé à chaque carte</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Archétype jungien</strong> — la figure universelle de l'inconscient que la carte incarne</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Symbolisme TdM</strong> — les détails visuels de la tradition marseillaise décryptés</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Invitation intérieure</strong> — la leçon de vie concrète que l'arcane vous adresse</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Méditation guidée</strong> — une visualisation pour travailler avec l'énergie de la carte</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Exercice de journaling</strong> — une pratique d'écriture pour ancrer la transformation</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Affirmation</strong> — une phrase puissante à intégrer au quotidien</div></li>
        <li><span class="feat-icon">✦</span><div><strong>Correspondances</strong> — élément, planète, couleur, pierre associés</div></li>
      </ul>
    </div>
  </div>
</section>

<!-- Bonus -->
<section id="bonus-section">
  <h2><span class="gold">Bonus inclus</span></h2>
  <div class="bonus-grid">
    <div class="bonus-card">
      <div class="bonus-icon">🔮</div>
      <h3>Votre Arcane Personnel</h3>
      <p>Calculez l'arcane qui gouverne votre chemin de vie entier à partir de votre date de naissance. La porte d'entrée idéale dans le guide.</p>
    </div>
    <div class="bonus-card">
      <div class="bonus-icon">🃏</div>
      <h3>Tirage "Portrait de l'Âme"</h3>
      <p>Un tirage exclusif en 5 positions conçu spécifiquement pour ce guide — pour obtenir un portrait complet de votre psyché du moment.</p>
    </div>
    <div class="bonus-card">
      <div class="bonus-icon">📋</div>
      <h3>Tableau de référence</h3>
      <p>Les 22 arcanes synthétisés en un tableau : numéro, réduction, archétype jungien et mots-clés pour une consultation rapide.</p>
    </div>
  </div>
</section>

<!-- Pour qui -->
<section id="for-who">
  <h2>Ce guide est fait pour vous si…</h2>
  <div class="who-grid">
    <div class="who-item">
      <span class="who-check">✓</span>
      Vous êtes curieux·se du Tarot mais trouvez les guides existants trop superficiels ou trop ésotériques
    </div>
    <div class="who-item">
      <span class="who-check">✓</span>
      Vous pratiquez le développement personnel et cherchez des outils d'introspection profonds
    </div>
    <div class="who-item">
      <span class="who-check">✓</span>
      Vous connaissez Jung et voulez explorer ses archétypes à travers le symbolisme des cartes
    </div>
    <div class="who-item">
      <span class="who-check">✓</span>
      Vous voulez une ressource complète, pratique et belle à consulter durablement
    </div>
  </div>
</section>

<!-- CTA final -->
<section id="cta-final">
  <div class="cta-box">
    <div class="cta-price">
      <span class="price-amount">7 €</span>
      <span class="price-label">accès à vie · PDF téléchargeable</span>
    </div>
    <a href={GUMROAD_URL} target="_blank" rel="noopener" class="btn-primary btn-large">
      ✦ Télécharger le guide maintenant
    </a>
    <p class="cta-reassurance">
      Paiement sécurisé via Gumroad &nbsp;·&nbsp; Téléchargement immédiat &nbsp;·&nbsp; Satisfait ou remboursé 30 jours
    </p>
    <p class="cta-rapport-link">
      Vous avez déjà acheté ? <a href="/rapport/">Générez votre Rapport d'Incarnation →</a>
    </p>
  </div>
</section>

</Layout>

<style is:global>

/* ── Hero ──────────────────────────────────────────── */
#boutique-hero {
  text-align: center;
  padding: 5rem 1.5rem 3rem;
  max-width: 720px;
  margin: 0 auto;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold);
  border: 1px solid rgba(223,178,108,0.3);
  border-radius: 999px;
  padding: 0.3rem 1rem;
  margin-bottom: 1.5rem;
}
.badge-dot {
  width: 6px; height: 6px;
  background: var(--gold);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.8)} }

#boutique-hero h1 {
  font-size: clamp(2.2rem, 6vw, 3.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  margin-bottom: 0.5rem;
}
.hero-sub {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  letter-spacing: 0.2em;
  color: var(--text-muted);
  margin-bottom: 1.25rem;
}
.hero-desc {
  font-size: 1rem;
  color: var(--text-muted);
  line-height: 1.8;
  margin-bottom: 2rem;
}
.btn-primary {
  display: inline-block;
  padding: 0.9rem 2.2rem;
  background: var(--gold);
  color: var(--bg-deep, #0d1117);
  font-weight: 700;
  font-size: 1rem;
  border-radius: 12px;
  text-decoration: none;
  transition: all 0.25s ease;
  box-shadow: 0 4px 20px rgba(223,178,108,0.25);
}
.btn-primary:hover {
  filter: brightness(1.1);
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(223,178,108,0.4);
}
.btn-large { padding: 1.1rem 3rem; font-size: 1.05rem; }
.hero-notice {
  margin-top: 1rem;
  font-size: 0.75rem;
  color: var(--text-muted);
  opacity: 0.7;
}

/* ── Showcase ──────────────────────────────────────── */
#product-showcase {
  max-width: 960px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
}
.showcase-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 3rem;
  align-items: start;
}

.cover-frame {
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 16px 48px rgba(0,0,0,0.3);
}
.cover-img {
  width: 100%;
  height: auto;
  display: block;
}
.cover-meta {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
}

.showcase-content h2 {
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
  color: var(--text);
}
.showcase-intro {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
  line-height: 1.7;
}

.feature-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}
.feature-list li {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  font-size: 0.9rem;
  line-height: 1.6;
}
.feat-icon {
  color: var(--gold);
  font-size: 0.75rem;
  margin-top: 0.25rem;
  flex-shrink: 0;
}
.feature-list strong { color: var(--text); }

/* ── Bonus ─────────────────────────────────────────── */
#bonus-section {
  background: var(--bg-card);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 4rem 1.5rem;
  text-align: center;
}
#bonus-section h2 { font-size: 1.6rem; margin-bottom: 2.5rem; }
.bonus-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  max-width: 840px;
  margin: 0 auto;
}
.bonus-card {
  background: var(--bg-deep, #0d1117);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.75rem 1.25rem;
  text-align: left;
}
.bonus-icon { font-size: 1.75rem; margin-bottom: 0.75rem; }
.bonus-card h3 {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 0.5rem;
}
.bonus-card p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; }

/* ── Pour qui ──────────────────────────────────────── */
#for-who {
  max-width: 720px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
  text-align: center;
}
#for-who h2 { font-size: 1.4rem; margin-bottom: 2rem; }
.who-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  text-align: left;
}
.who-item {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.6;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1rem;
}
.who-check {
  color: var(--gold);
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 0.1rem;
}

/* ── CTA Final ─────────────────────────────────────── */
#cta-final {
  padding: 3rem 1.5rem 5rem;
  text-align: center;
}
.cta-box {
  max-width: 480px;
  margin: 0 auto;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 2.5rem 2rem;
}
.cta-price {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 1.5rem;
}
.price-amount {
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--gold);
  line-height: 1;
}
.price-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 0.1em;
  margin-top: 0.25rem;
}
.cta-reassurance {
  margin-top: 1rem;
  font-size: 0.72rem;
  color: var(--text-muted);
  opacity: 0.7;
  line-height: 1.6;
}
.cta-rapport-link {
  margin-top: 1.2rem;
  font-size: 0.82rem;
  color: var(--text-muted);
}
.cta-rapport-link a {
  color: var(--gold);
  text-decoration: none;
  font-weight: 600;
}
.cta-rapport-link a:hover { text-decoration: underline; }

/* ── Responsive ────────────────────────────────────── */
@media (max-width: 768px) {
  .showcase-grid { grid-template-columns: 1fr; }
  .cover-frame { max-width: 240px; margin: 0 auto; }
  .bonus-grid { grid-template-columns: 1fr; }
  .who-grid { grid-template-columns: 1fr; }
}
</style>
