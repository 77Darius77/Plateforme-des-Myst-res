        <td>Le Fils benjamin</td>
      </tr>
      <tr>
        <td>☴</td>
        <td><strong>Xun</strong> (巽)</td>
        <td>Le Vent, le Bois</td>
        <td>Pénétration douce, influence</td>
        <td>Sud-Est</td>
        <td>La Fille aînée</td>
      </tr>
      <tr>
