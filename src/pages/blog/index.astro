<script>
document.addEventListener('DOMContentLoaded', () => {
  const PREVIEW = 4;

  document.querySelectorAll('.blog-category .blog-grid').forEach(grid => {
    const allChildren = Array.from(grid.children);
    const cards = allChildren.filter(el => el.classList.contains('blog-card'));

    if (cards.length <= PREVIEW) return;

    // Index du 4e card dans les enfants du grid
    const lastVisibleIdx = allChildren.indexOf(cards[PREVIEW - 1]);
    const toHide = allChildren.slice(lastVisibleIdx + 1);
    toHide.forEach(el => el.classList.add('grid-hidden'));

    const hiddenCardCount = cards.length - PREVIEW;

    const btn = document.createElement('button');
    btn.className = 'blog-expand-btn';
    btn.setAttribute('aria-expanded', 'false');
    btn.innerHTML = `Voir les ${hiddenCardCount} autres articles <span class="expand-chevron">▼</span>`;
    grid.appendChild(btn);

    btn.addEventListener('click', () => {
      const open = !btn.classList.contains('is-open');
      btn.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      toHide.forEach(el => el.classList.toggle('grid-hidden', !open));
      btn.innerHTML = open
        ? `Réduire <span class="expand-chevron">▲</span>`
        : `Voir les ${hiddenCardCount} autres articles <span class="expand-chevron">▼</span>`;
    });
  });

  // Sidebar : clic sur "Portraits" → expand Numérologie si fermé, puis scroll
  const portraitLink = document.querySelector('.sidebar-subcat[href="#cat-portraits"]');
  if (portraitLink) {
    portraitLink.addEventListener('click', (e) => {
      const target = document.getElementById('cat-portraits');
      if (!target) return;
      const grid = target.closest('.blog-grid');
      if (!grid) return;
      const btn = grid.querySelector('.blog-expand-btn');
      if (btn && !btn.classList.contains('is-open')) {
        e.preventDefault();
        btn.click();
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 60);
      }
    });
  }
});
</script>

