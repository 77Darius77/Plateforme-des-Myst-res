---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog — Plateforme des Mystères",
  "url": "https://mysteres.fr/blog/",
  "description": "51 articles sur la numérologie, le tarot, l'astrologie et les oracles. Sagesses ancestrales, analyses approfondies et guides pratiques.",
  "inLanguage": "fr"
};
---

<Layout
  title="Blog — Plateforme des Mystères"
  description="51 articles sur la numérologie, le tarot, l'astrologie et les oracles. Sagesses ancestrales, analyses approfondies et guides pratiques."
  keywords="numérologie, tarot, astrologie, oracles, blog, ésotérisme, archétypes, Raúl Durán, kabbale, ticún, chemin de vie"
  canonicalPath="blog/"
  jsonLd={jsonLd}
  useBlogStyles={true}
  section="blog"
>

<!-- ═══════════ HERO ═══════════ -->
<section class="blog-hero">
  <div class="hero-badge">Journal ésotérique</div>
  <h1>Le <span class="gold">Blog</span> des <span class="emerald">Mystères</span></h1>
  <p class="hero-desc">
    Numérologie cabalistique, pythagoricienne, chaldéenne et chinoise — Tarot de Marseille,
    Rider-Waite, Thoth, Lenormand — Astrologie tropicale, sidérale, védique, chinoise —
    Oracles de Belline, Géomancie, Triade, Miroirs, Runes, Yi King.
  </p>
  <div class="hero-stats">
    <div class="hero-stat" data-tooltip="Articles approfondis couvrant toutes les disciplines ésotériques">
      <span class="hero-stat-num">51</span> <span class="hero-stat-label">articles</span>
    </div>
    <div class="hero-stat" data-tooltip="Numérologie, Tarologie, Astrologie, Oracles, Ponts">
      <span class="hero-stat-num">5</span> <span class="hero-stat-label">disciplines</span>
    </div>
    <div class="hero-stat" data-tooltip="Cabalistique·Pythagore·Chaldée·Chine / Marseille·RWS·Thoth·Lenormand / Tropicale·Sidérale·Védique·Chinoise / Belline·Géomancie·Runes·Yi King…">
      <span class="hero-stat-num">4</span> <span class="hero-stat-label">traditions</span>
    </div>
    <div class="hero-stat" data-tooltip="Des sagesses ancestrales décryptées pour le XXIᵉ siècle">
      <span class="hero-stat-num">×</span> <span class="hero-stat-label">sagesses</span>
    </div>
  </div>
</section>

