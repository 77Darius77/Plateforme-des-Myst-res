      <tr><td><strong>Lion</strong> ♌</td><td>Feu</td><td>Fixe</td><td>Soleil</td><td>23 juillet — 22 août</td></tr>
      <tr><td><strong>Vierge</strong> ♍</td><td>Terre</td><td>Mutable</td><td>Mercure</td><td>23 août — 22 septembre</td></tr>
