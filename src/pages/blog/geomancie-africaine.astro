      <tr><td><strong>Ogunda</strong></td><td>9e</td><td>Chemin dégagé, courage, Ogoun</td></tr>
      <tr><td><strong>Osa</strong></td><td>10e</td><td>Disruption, sorcellerie, changement brutal</td></tr>
