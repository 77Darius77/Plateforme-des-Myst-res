---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Alignement Alchimique — Tarot de Thoth"
  description="Effectuez un tirage d'Alignement Alchimique en 4 cartes (Feu, Eau, Air, Terre) avec le Tarot de Thoth d'Aleister Crowley."
  keywords="tarot de thoth, alchimie, 4 elements, alignement alchimique, tirage gratuit"
  canonicalPath="tarologie/thoth/spirituel.html"
  section="tarologie"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="../../index.html" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="../index.html" style="color:var(--cyan);">Tarologie</a> &rsaquo;
  <a href="../thoth.html" style="color:var(--cyan);">Tarot de Thoth</a> &rsaquo;
  <span style="color:var(--text);">Alignement Alchimique</span>
</nav>

<main style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;text-align:center;">
  <h1>Alignement <span class="emerald">Alchimique</span></h1>
  <p class="subtitle">Harmonisez vos quatre plans d'expression élémentaire : Feu de la Volonté, Eau de l'Émotion, Air de la Pensée et Terre de l'Ancrage. Sélectionnez 4 cartes.</p>

  <!-- Etape 1 : Le paquet et l'étalement -->
  <div id="deck-area" style="margin-top:2rem;position:relative;height:250px;display:flex;justify-content:center;align-items:center;">
    <button id="btn-spread" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;z-index:10;">Étaler le jeu de Thoth ✦</button>
    
    <div id="spread-container" style="display:none;position:relative;width:100%;height:100%;max-width:900px;margin:0 auto;">
      <p id="instruction-text" style="position:absolute;top:-40px;width:100%;color:var(--cyan);font-weight:bold;font-size:1.1rem;">Sélectionnez 4 cartes (0/4)</p>
    </div>
  </div>

  <!-- Etape 2 : Le résultat (Les emplacements) -->
  <div id="resultats" style="margin-top:3rem;">
    <div class="quad-grid">
      
      <!-- Les 4 emplacements des Éléments -->
      {[
        { id: 1, name: "1. Le Feu (Volonté & Désir)", border: "var(--rose)" },
        { id: 2, name: "2. L'Eau (Émotions & Intuition)", border: "var(--cyan)" },
        { id: 3, name: "3. L'Air (Mental & Logique)", border: "var(--violet)" },
        { id: 4, name: "4. La Terre (Ancrage & Corps)", border: "var(--emerald)" }
      ].map((pos) => (
        <div class="tarot-card-container">
          <div class="tarot-pos">{pos.name}</div>
          <div class="tarot-card" id={`slot-${pos.id}`}>
            <div class="card-inner">
              <div class="card-front empty-slot"></div>
              <div class="card-back" style={`border-color:${pos.border};`}>
                <img id={`img-${pos.id}`} src="" alt="" class="card-img" />
                <h3 id={`name-${pos.id}`}></h3>
                <div class="esoteric-metadata">
                  <div class="meta-row"><strong>Hebreux:</strong> <span id={`kab-${pos.id}`}></span></div>
                  <div class="meta-row"><strong>Astro:</strong> <span id={`ast-${pos.id}`}></span></div>
                  <div class="meta-row"><strong>Alchimie:</strong> <span id={`alc-${pos.id}`}></span></div>
                </div>
                <p id={`mean-${pos.id}`} class="meaning"></p>
              </div>
            </div>
          </div>
        </div>
      ))}
      
    </div>
    
    <div id="reveal-area" style="display:none;margin-top:2rem;">
      <button id="btn-reveal" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;">Révéler le tirage de Thoth ✦</button>
    </div>

    <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

    <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);">Ce tirage vous offre des pistes de réflexion ésotériques. Le libre arbitre reste votre maître suprême.</p>
  </div>
</main>

<style>
  .quad-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .quad-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .quad-grid {
      grid-template-columns: 1fr;
    }
  }

  .tarot-card-container { 
    width: 100%; 
    max-width: 190px;
    margin: 0 auto;
  }
  
  .tarot-pos { 
    font-family: var(--font-mono); 
    font-size: 0.7rem; 
    color: var(--cyan); 
    margin-bottom: 0.4rem; 
    text-transform: uppercase; 
    letter-spacing: 1px; 
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .tarot-card { width: 100%; height: 350px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .tarot-card.flipped .card-inner { transform: rotateY(180deg); }
  
  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--cyan); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 0.5rem; }
  
  .card-front { 
    background-image: url('/images/tarot/card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center; 
  }
  
  .empty-slot {
    background: rgba(255,255,255,0.03);
    background-image: none;
    border: 2px dashed rgba(0, 188, 212, 0.4);
  }
  .filled-slot {
    background-image: url('/images/tarot/card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--cyan);
    box-shadow: 0 0 10px rgba(0, 188, 212, 0.3);
  }
  
  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow-y: auto; justify-content: flex-start; align-items: center; }
  .card-img { width: 100%; border-radius: 4px; margin-bottom: 0.4rem; max-height: 140px; object-fit: contain; }
  .card-back h3 { color: var(--gold); font-size: 0.9rem; margin-bottom: 0.3rem; border-bottom: 1px solid rgba(212, 175, 55, 0.2); padding-bottom: 0.3rem; width: 100%; }
  
  .esoteric-metadata {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-align: left;
    width: 100%;
    margin-bottom: 0.4rem;
    background: rgba(255,255,255,0.02);
    padding: 0.3rem;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .meta-row {
    margin-bottom: 0.15rem;
    line-height: 1.2;
  }
  
  .meaning { font-size: 0.7rem; line-height: 1.3; color: var(--text-muted); text-align: left; }
</style>

<style is:global>
  .spread-card {
    position: absolute;
    width: 60px;
    height: 110px;
    background-image: url('/images/tarot/card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid #00bcd4;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 50px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 4px rgba(0, 188, 212, 0.15);
  }
  .spread-card:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 12px rgba(0, 188, 212, 0.5);
  }
  .spread-card.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>

<script is:inline src="/js/tarot-thoth-data.js"></script>
<script is:inline src="/js/tarot-positions.js"></script>
<script is:inline src="/js/tarot-cardtypes.js"></script>
<script is:inline src="/js/tarot-thoth-planes.js"></script>
<script is:inline src="/js/tarot-thoth-interp.js"></script>
<script is:inline>
  function initTarotSpread() {
    const btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    const MAX_CARDS = 4;
    let selectedCards = [];
    let deckIndices = [];

    const newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', () => {
      newBtnSpread.style.display = 'none';
      const container = document.getElementById('spread-container');
      container.style.display = 'block';
      
      container.querySelectorAll('.spread-card').forEach(c => c.remove());
      
      const deckSize = window.tarotThothData.length;
      deckIndices = Array.from({length: deckSize}, (_, i) => i).sort(() => 0.5 - Math.random());
      
      void container.offsetWidth;
      const containerWidth = container.offsetWidth > 0 ? container.offsetWidth : Math.min(window.innerWidth - 40, 800);
      const cardWidth = 60;
      const step = (containerWidth - cardWidth) / (deckSize - 1);
      
      for(let i=0; i<deckSize; i++) {
        const card = document.createElement('div');
        card.className = 'spread-card';
        card.style.left = `${i * step}px`;
        card.style.zIndex = i;
        
        const middle = (deckSize - 1) / 2;
        const distanceFromCenter = Math.abs(i - middle);
        const yOffset = (distanceFromCenter * distanceFromCenter) * 0.035;
        const rotation = (i - middle) * (36 / deckSize);
        
        card.style.transform = `translateY(${yOffset}px) rotate(${rotation}deg)`;
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        
        card.addEventListener('click', () => selectCard(card));
        container.appendChild(card);
      }
    });

    function selectCard(cardEl) {
      if(selectedCards.length >= MAX_CARDS) return;
      
      cardEl.classList.add('selected');
      const actualCardData = window.tarotThothData[cardEl.dataset.index];
      selectedCards.push(actualCardData);
      
      const slotIdx = selectedCards.length;
      const slotFront = document.querySelector(`#slot-${slotIdx} .card-front`);
      if(slotFront) {
        slotFront.classList.remove('empty-slot');
        slotFront.classList.add('filled-slot');
      }
      
      const instr = document.getElementById('instruction-text');
      if(instr) instr.innerText = `Sélectionnez ${MAX_CARDS} cartes (${selectedCards.length}/${MAX_CARDS})`;
      
      if(selectedCards.length === MAX_CARDS) {
        if(instr) instr.innerText = "Tirage complet.";
        setTimeout(() => {
          document.getElementById('deck-area').style.display = 'none';
          document.getElementById('reveal-area').style.display = 'block';
        }, 800);
      }
    }

    const btnReveal = document.getElementById('btn-reveal');
    if (btnReveal) {
      const newBtnReveal = btnReveal.cloneNode(true);
      btnReveal.parentNode.replaceChild(newBtnReveal, btnReveal);
      newBtnReveal.addEventListener('click', () => {
        newBtnReveal.style.display = 'none';

        setTimeout(() => {
          for(let i=1; i<=MAX_CARDS; i++) {
            const cardData = selectedCards[i-1];
            document.getElementById(`img-${i}`).src = cardData.img;
            document.getElementById(`name-${i}`).innerText = cardData.name;
            document.getElementById(`kab-${i}`).innerText = cardData.kabbale || 'N/A';
            document.getElementById(`ast-${i}`).innerText = cardData.astrologie || 'N/A';
            document.getElementById(`alc-${i}`).innerText = cardData.alchimie || 'N/A';
            document.getElementById(`mean-${i}`).innerText = cardData.meaning;
            setTimeout(() => {
              document.getElementById(`slot-${i}`).classList.add('flipped');
            }, i * 250);
          }
        }, 100);

        setTimeout(() => {
          const rs = document.getElementById('reading-section');
          if (rs && window.tarotThothInterp) {
            rs.innerHTML = window.tarotThothInterp.generateReading('spirituel', selectedCards)
              + window.tarotThothInterp.generateAllPlaneReadings('spirituel', selectedCards);
            rs.style.display = 'block';
            rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
            initPlaneTabs(rs);
          }
        }, 1800);
      });
    }

    function initPlaneTabs(root) {
      const tabs = root.querySelectorAll('.tr-plane-tab');
      const panes = root.querySelectorAll('.tr-plane-pane');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const plane = tab.dataset.plane;
          tabs.forEach(t => t.classList.toggle('active', t === tab));
          panes.forEach(p => p.classList.toggle('active', p.dataset.plane === plane));
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTarotSpread);
  } else {
    initTarotSpread();
  }
  document.addEventListener('astro:page-load', initTarotSpread);
</script>

</Layout>
