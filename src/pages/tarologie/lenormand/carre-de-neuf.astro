---
import Layout from '../../../layouts/Layout.astro';
import LenormandSpread from '../../../components/LenormandSpread.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "name": "Le Carré de 9 — Petit Lenormand",
  "url": "https://plateforme-des-mysteres.com/tarologie/lenormand/carre-de-neuf/",
  "description": "Tirage du Carré de 9 (3x3) du Petit Lenormand offrant un panorama complet : conscient, affectif, physique et temporel.",
  "inLanguage": "fr"
};
---

<Layout
  title="Le Carré de 9 — Petit Lenormand"
  description="Carré de 9 du Petit Lenormand : une grille 3x3 offrant un panorama complet conscient, affectif, physique et temporel de votre situation. Tirage gratuit."
  keywords="petit lenormand, carré de 9, carré de neuf, tirage 9 cartes, divination, tarologie"
  canonicalPath="tarologie/lenormand/carre-de-neuf/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Tarologie", item: "https://plateforme-des-mysteres.com/tarologie/" },
    { name: "Petit Lenormand", item: "https://plateforme-des-mysteres.com/tarologie/lenormand/" },
    { name: "Le Carré de 9", item: "https://plateforme-des-mysteres.com/tarologie/lenormand/carre-de-neuf/" }
  ]}
  section="tarologie"
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/tarologie/" style="color:var(--cyan);">Tarologie</a> &rsaquo;
  <a href="/tarologie/lenormand/" style="color:var(--cyan);">Petit Lenormand</a> &rsaquo;
  <span style="color:var(--text);">Le Carré de 9</span>
</nav>

<main style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;">
  <section id="hero" style="text-align:center;padding:2rem 1.5rem 2rem;max-width:800px;margin:0 auto;">
    <h1>
      <span class="pulse"></span>
      ⚃ <span class="gold">Le Carré de 9</span><br>Un panorama <span class="rose">complet</span>
    </h1>
    <p class="subtitle">
      Neuf cartes du Petit Lenormand disposées en grille 3x3 pour un panorama complet de votre situation : plan conscient, affectif, physique et lecture temporelle passé-présent-futur.
    </p>
    <h2 class="sr-only">Résultat du tirage</h2>
  </section>

  <LenormandSpread spread="carre-de-neuf" />
</main>

</Layout>
