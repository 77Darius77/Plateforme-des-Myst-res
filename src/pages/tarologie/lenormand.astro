---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Petit Lenormand — Méthodes de Tirage",
  "url": "https://plateforme-des-mysteres.com/tarologie/lenormand/",
  "description": "Découvrez les 4 méthodes de tirage du Petit Lenormand : tirage quotidien, ligne du temps, carré de 9 et Grand Tableau.",
  "inLanguage": "fr"
};
---

<Layout
  title="Petit Lenormand — Méthodes de tirage"
  description="Les 4 tirages du Petit Lenormand : tirage quotidien, ligne du temps, carré de 9 et Grand Tableau. 36 cartes pour une divination claire et concrète."
  keywords="petit lenormand, lenormand, cartes divinatoires, mademoiselle lenormand, divination, tarologie, grand tableau, tirage gratuit"
  canonicalPath="tarologie/lenormand/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Tarologie", item: "https://plateforme-des-mysteres.com/tarologie/" },
    { name: "Petit Lenormand", item: "https://plateforme-des-mysteres.com/tarologie/lenormand/" }
  ]}
  section="tarologie"
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/tarologie/" style="color:var(--cyan);">Tarologie</a> &rsaquo;
  <span style="color:var(--text);">Petit Lenormand</span>
</nav>

<div class="hub-container">
  <aside class="hub-sidebar">
    <h1>
      <span class="pulse"></span>
      🔮 <span class="gold">Petit Lenormand</span><br>La divination <span class="rose">quotidienne</span>
    </h1>
    <p class="subtitle">
      Le Petit Lenormand, avec ses 36 arcanes au langage concret et combinatoire, est l'outil parfait pour obtenir des réponses claires sur le plan matériel, affectif ou professionnel.
      Choisissez la méthode de tirage la plus adaptée à votre question.
    </p>
  </aside>

  <main class="hub-main">
    <div class="section-title">
      <div class="num">[ 01 ]</div>
      <h2>✦ Les 4 Tirages</h2>
      <p class="slate">Du conseil rapide au panorama complet de votre vie.</p>
    </div>

    <div class="mystere-grid">

      <!-- Carte 1 : Tirage Quotidien -->
      <div class="mystere-card" style="--card-accent-color: var(--gold-text); --hover-accent-color: var(--gold-text);">
        <div class="card-icon">🏇</div>
        <h3>TIRAGE QUOTIDIEN</h3>
        <p>
          1 carte pour obtenir un conseil concret ou une prédiction rapide pour votre journée. La méthode la plus simple et directe.
        </p>
        <a href="/tarologie/lenormand/quotidien/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

      <!-- Carte 2 : Ligne du Temps -->
      <div class="mystere-card" style="--card-accent-color: var(--emerald); --hover-accent-color: var(--emerald);">
        <div class="card-icon">⏳</div>
        <h3>LIGNE DU TEMPS</h3>
        <p>
          3 cartes lues comme une phrase narrative reliant votre passé, votre présent et votre futur proche. Idéal pour suivre l'évolution d'une situation.
        </p>
        <a href="/tarologie/lenormand/ligne-du-temps/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

      <!-- Carte 3 : Le Carré de 9 -->
      <div class="mystere-card" style="--card-accent-color: var(--violet); --hover-accent-color: var(--violet);">
        <div class="card-icon">⚃</div>
        <h3>LE CARRÉ DE 9</h3>
        <p>
          3x3 cartes offrant un panorama complet : plan conscient, affectif, physique et lecture temporelle passé-présent-futur.
        </p>
        <a href="/tarologie/lenormand/carre-de-neuf/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

      <!-- Carte 4 : Grand Tableau -->
      <div class="mystere-card" style="--card-accent-color: var(--rose); --hover-accent-color: var(--rose);">
        <div class="card-icon">🏰</div>
        <h3>GRAND TABLEAU</h3>
        <p>
          Le tirage traditionnel suprême disposant les 36 cartes pour cartographier tous les domaines de votre vie à travers le système des maisons.
        </p>
        <a href="/tarologie/lenormand/grand-tableau/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

    </div>
  </main>
</div>

<!-- ═══════════ NAVIGATION PRÉCÉDENT / SUIVANT ═══════════ -->
<nav class="sub-nav" style="display:flex;justify-content:space-between;max-width:600px;margin:2rem auto;padding:1rem;">
  <a href="/tarologie/thoth/" style="color:var(--cyan);font-family:var(--font-mono);">← Tarot de Thoth</a>
  <a href="/tarologie/" style="color:var(--cyan);font-family:var(--font-mono);">Retour à l'accueil Tarologie</a>
</nav>

</Layout>
