---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Le Fer à Cheval — Tarot Rider-Waite-Smith"
  description="Effectuez un tirage en Fer à Cheval gratuit avec le Tarot Rider-Waite-Smith."
  keywords="tarot, fer a cheval, tirage gratuit, rider waite"
  canonicalPath="tarologie/rider-waite/fer-a-cheval/"
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Tarologie", item: "https://plateforme-des-mysteres.com/tarologie/" },
    { name: "Tarot Rider-Waite-Smith", item: "https://plateforme-des-mysteres.com/tarologie/rider-waite/" },
    { name: "Fer à Cheval", item: "https://plateforme-des-mysteres.com/tarologie/rider-waite/fer-a-cheval/" }
  ]}
  section="tarologie"
>

<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/tarologie/" style="color:var(--cyan);">Tarologie</a> &rsaquo;
  <a href="/tarologie/rider-waite/" style="color:var(--cyan);">Tarot Rider-Waite-Smith</a> &rsaquo;
  <span style="color:var(--text);">Fer à Cheval</span>
</nav>

<main style="max-width:1200px;margin:0 auto;padding:2rem 1.5rem;text-align:center;">
  <h1>Le <span class="gold">Fer à Cheval</span></h1>
  <p class="subtitle">Concentrez-vous sur votre projet ou votre décision. Étalez les cartes, puis choisissez-en 7.</p>
  <h2 class="sr-only">Résultat du tirage</h2>

  <!-- Etape 1 : Le paquet et l'étalement -->
  <div id="deck-area" style="margin-top:2rem;position:relative;height:250px;display:flex;justify-content:center;align-items:center;">
    <button id="btn-spread" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;z-index:10;">Étaler les cartes ✦</button>
    
    <div id="spread-container" style="display:none;position:relative;width:100%;height:100%;max-width:800px;margin:0 auto;">
      <p id="instruction-text" style="position:absolute;top:-40px;width:100%;color:var(--gold);font-weight:bold;font-size:1.1rem;">Sélectionnez 7 cartes (0/7)</p>
    </div>
  </div>

  <!-- Etape 2 : Le résultat (Les emplacements) -->
  <div id="resultats" style="margin-top:3rem;">
    <div class="horseshoe-layout">
      
      <!-- Carte 3 : Doutes/Craintes -->
      <div class="tarot-card-container pos-3">
        <div class="tarot-pos">3. Craintes & Doutes</div>
        <div class="tarot-card" id="slot-3">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-3" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-3"></h3>
              <p id="mean-3" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 4 : L'Obstacle -->
      <div class="tarot-card-container pos-4">
        <div class="tarot-pos" style="color:var(--rose);">4. L'Obstacle</div>
        <div class="tarot-card" id="slot-4">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back" style="border-color:var(--rose);">
              <img id="img-4" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-4" style="color:var(--rose);"></h3>
              <p id="mean-4" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 5 : L'Entourage -->
      <div class="tarot-card-container pos-5">
        <div class="tarot-pos">5. L'Entourage</div>
        <div class="tarot-card" id="slot-5">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-5" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-5"></h3>
              <p id="mean-5" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 2 : Le Présent -->
      <div class="tarot-card-container pos-2">
        <div class="tarot-pos">2. Le Présent</div>
        <div class="tarot-card" id="slot-2">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-2" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-2"></h3>
              <p id="mean-2" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 6 : Le Conseil -->
      <div class="tarot-card-container pos-6">
        <div class="tarot-pos" style="color:var(--emerald);">6. Le Conseil</div>
        <div class="tarot-card" id="slot-6">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back" style="border-color:var(--emerald);">
              <img id="img-6" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-6" style="color:var(--emerald);"></h3>
              <p id="mean-6" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 1 : Le Passé -->
      <div class="tarot-card-container pos-1">
        <div class="tarot-pos">1. Le Passé</div>
        <div class="tarot-card" id="slot-1">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back">
              <img id="img-1" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-1"></h3>
              <p id="mean-1" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 7 : L'Issue -->
      <div class="tarot-card-container pos-7">
        <div class="tarot-pos" style="color:var(--gold);">7. L'Issue</div>
        <div class="tarot-card" id="slot-7">
          <div class="card-inner">
            <div class="card-front empty-slot"></div>
            <div class="card-back" style="border-color:var(--gold);">
              <img id="img-7" src="" alt="" loading="lazy" class="card-img">
              <h3 id="name-7" style="color:var(--gold);"></h3>
              <p id="mean-7" class="meaning"></p>
            </div>
          </div>
        </div>
      </div>

    </div>
    
    <div id="reveal-area" style="display:none;margin-top:2rem;">
      <button id="btn-reveal" class="btn-explore" style="font-size:1.2rem;padding:1rem 2rem;cursor:pointer;">Révéler le tirage ✦</button>
    </div>

    <div id="reading-section" class="tr-outer" style="display:none;margin-top:2.5rem;"></div>

    <p style="margin-top:2rem;font-style:italic;color:var(--text-muted);">Ce tirage vous offre des pistes de réflexion. Le libre arbitre reste votre meilleur guide.</p>
  </div>
</main>

<style>
  .horseshoe-layout {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 1.5rem;
    justify-items: center;
    align-items: start;
    max-width: 1000px;
    margin: 0 auto;
  }

  .pos-3 { grid-column: 2; grid-row: 1; }
  .pos-4 { grid-column: 3; grid-row: 1; }
  .pos-5 { grid-column: 4; grid-row: 1; }
  .pos-2 { grid-column: 1; grid-row: 2; }
  .pos-6 { grid-column: 5; grid-row: 2; }
  .pos-1 { grid-column: 1; grid-row: 3; }
  .pos-7 { grid-column: 5; grid-row: 3; }

  .tarot-card-container { width: 170px; }
  .tarot-pos { font-family: var(--font-mono); font-size: 0.75rem; color: var(--gold); margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 1px; }
  
  .tarot-card { width: 100%; height: 320px; perspective: 1000px; }
  .card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.8s; transform-style: preserve-3d; }
  .tarot-card.flipped .card-inner { transform: rotateY(180deg); }
  
  .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; border: 2px solid var(--gold); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding: 0.6rem; }
  
  .card-front { 
    background-image: url('/images/tarot/card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center; align-items: center; 
  }
  
  .empty-slot {
    background: rgba(255,255,255,0.03);
    background-image: none;
    border: 2px dashed rgba(212, 175, 55, 0.4);
  }
  .filled-slot {
    background-image: url('/images/tarot/card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 2px solid var(--gold);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
  }
  
  .card-back { background: var(--bg-card); transform: rotateY(180deg); box-shadow: 0 8px 16px rgba(0,0,0,0.6); overflow-y: auto; justify-content: flex-start; align-items: center; }
  .card-img { width: 100%; border-radius: 4px; margin-bottom: 0.4rem; max-height: 160px; object-fit: contain; }
  .card-back h3 { color: var(--gold); font-size: 1rem; margin-bottom: 0.3rem; border-bottom: 1px solid rgba(212, 175, 55, 0.2); padding-bottom: 0.3rem; width: 100%; }
  .meaning { font-size: 0.75rem; line-height: 1.4; color: var(--text-muted); text-align: left; }

  @media (max-width: 768px) {
    .horseshoe-layout { display: flex; flex-wrap: wrap; justify-content: center; }
  }
</style>

<style is:global>
  .spread-card {
    position: absolute;
    width: 60px;
    height: 110px;
    background-image: url('/images/tarot/card-back.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1px solid #d4af37;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    top: 50px;
    box-shadow: -2px 0px 6px rgba(0,0,0,0.9), 0 0 4px rgba(212, 175, 55, 0.15);
  }
  .spread-card:hover {
    transform: translateY(-18px) !important;
    z-index: 100 !important;
    box-shadow: 0px 12px 20px rgba(0,0,0,0.7), 0 0 12px rgba(212, 175, 55, 0.5);
  }
  .spread-card.selected {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>

<script is:inline src="/js/tarot-rws-data.js"></script>
<script is:inline src="/js/tarot-positions.js"></script>
<script is:inline src="/js/tarot-cardtypes.js"></script>
<script is:inline src="/js/tarot-rws-planes.js"></script>
<script is:inline src="/js/tarot-rws-interp.js"></script>
<script is:inline>
  function initTarotSpread() {
    const btnSpread = document.getElementById('btn-spread');
    if (!btnSpread || btnSpread.dataset.initialized) return;
    btnSpread.dataset.initialized = "true";

    const MAX_CARDS = 7;
    let selectedCards = [];
    let deckIndices = [];

    const newBtnSpread = btnSpread.cloneNode(true);
    btnSpread.parentNode.replaceChild(newBtnSpread, btnSpread);

    newBtnSpread.addEventListener('click', () => {
      newBtnSpread.style.display = 'none';
      const container = document.getElementById('spread-container');
      container.style.display = 'block';
      
      container.querySelectorAll('.spread-card').forEach(c => c.remove());
      
      const deckSize = window.tarotRwsData.length;
      deckIndices = Array.from({length: deckSize}, (_, i) => i).sort(() => 0.5 - Math.random());
      
      void container.offsetWidth;
      const containerWidth = container.offsetWidth > 0 ? container.offsetWidth : Math.min(window.innerWidth - 40, 800);
      const cardWidth = 60;
      const step = (containerWidth - cardWidth) / (deckSize - 1);
      
      for(let i=0; i<deckSize; i++) {
        const card = document.createElement('div');
        card.className = 'spread-card';
        card.style.left = `${i * step}px`;
        card.style.zIndex = i;
        
        const middle = (deckSize - 1) / 2;
        const distanceFromCenter = Math.abs(i - middle);
        const yOffset = (distanceFromCenter * distanceFromCenter) * 0.035;
        const rotation = (i - middle) * (36 / deckSize);
        
        card.style.transform = `translateY(${yOffset}px) rotate(${rotation}deg)`;
        card.dataset.index = deckIndices[i];
        card.dataset.id = i;
        card.setAttribute('tabindex', '0');
        card.setAttribute('role', 'button');
        card.setAttribute('aria-label', `Carte ${i + 1} sur ${deckSize}, face cachée`);

        card.addEventListener('click', () => selectCard(card));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCard(card); }
        });
        container.appendChild(card);
      }
    });

    function selectCard(cardEl) {
      if(selectedCards.length >= MAX_CARDS) return;
      
      cardEl.classList.add('selected');
      const actualCardData = window.tarotRwsData[cardEl.dataset.index];
      selectedCards.push(actualCardData);
      
      const slotIdx = selectedCards.length;
      const slotFront = document.querySelector(`#slot-${slotIdx} .card-front`);
      if(slotFront) {
        slotFront.classList.remove('empty-slot');
        slotFront.classList.add('filled-slot');
      }
      
      const instr = document.getElementById('instruction-text');
      if(instr) instr.innerText = `Sélectionnez ${MAX_CARDS} cartes (${selectedCards.length}/${MAX_CARDS})`;
      
      if(selectedCards.length === MAX_CARDS) {
        if(instr) instr.innerText = "Tirage complet.";
        setTimeout(() => {
          document.getElementById('deck-area').style.display = 'none';
          document.getElementById('reveal-area').style.display = 'block';
        }, 800);
      }
    }

    const btnReveal = document.getElementById('btn-reveal');
    if (btnReveal) {
      const newBtnReveal = btnReveal.cloneNode(true);
      btnReveal.parentNode.replaceChild(newBtnReveal, btnReveal);
      newBtnReveal.addEventListener('click', () => {
        newBtnReveal.style.display = 'none';

        setTimeout(() => {
          for(let i=1; i<=MAX_CARDS; i++) {
            const cardData = selectedCards[i-1];
            document.getElementById(`img-${i}`).src = cardData.img;
            document.getElementById(`img-${i}`).alt = cardData.name;
            document.getElementById(`name-${i}`).innerText = cardData.name;
            document.getElementById(`mean-${i}`).innerText = cardData.meaning;
            setTimeout(() => {
              document.getElementById(`slot-${i}`).classList.add('flipped');
            }, i * 250);
          }
        }, 100);

        setTimeout(() => {
          const rs = document.getElementById('reading-section');
          if (rs && window.tarotRwsInterp) {
            rs.innerHTML = window.tarotRwsInterp.generateReading('fer-a-cheval', selectedCards)
              + window.tarotRwsInterp.generateAllPlaneReadings('fer-a-cheval', selectedCards);
            rs.style.display = 'block';
            rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
            initPlaneTabs(rs);
          }
        }, 2500);
      });
    }

    function initPlaneTabs(root) {
      const tabs = root.querySelectorAll('.tr-plane-tab');
      const panes = root.querySelectorAll('.tr-plane-pane');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const plane = tab.dataset.plane;
          tabs.forEach(t => t.classList.toggle('active', t === tab));
          panes.forEach(p => p.classList.toggle('active', p.dataset.plane === plane));
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTarotSpread);
  } else {
    initTarotSpread();
  }
  document.addEventListener('astro:page-load', initTarotSpread);
</script>

</Layout>
