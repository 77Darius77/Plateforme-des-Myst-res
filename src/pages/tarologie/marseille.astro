---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Tarot de Marseille — Méthodes de Tirage",
  "url": "https://mysteres.fr/tarologie/marseille.html",
  "description": "Découvrez les 4 méthodes de tirage principales du Tarot de Marseille : 3 cartes, croix, ligne et astrologique.",
  "inLanguage": "fr"
};
---

<Layout
  title="Tarot de Marseille — Méthodes de tirage"
  description="Découvrez 4 méthodes de tirage du Tarot de Marseille : le tirage à 3 cartes, le tirage en croix, le tirage en ligne et le tirage astrologique."
  keywords="tarot de marseille, méthodes de tirage, tirage en croix, tirage 3 cartes, tarologie"
  canonicalPath="tarologie/marseille/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://mysteres.fr/" },
    { name: "Tarologie", item: "https://mysteres.fr/tarologie/" },
    { name: "Tarot de Marseille", item: "https://mysteres.fr/tarologie/marseille/" }
  ]}
  section="tarologie"
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/tarologie/" style="color:var(--cyan);">Tarologie</a> &rsaquo;
  <span style="color:var(--text);">Tarot de Marseille</span>
</nav>

<div class="hub-container">
  <aside class="hub-sidebar">
    <h1>
      <span class="pulse"></span>
      🃏 <span class="gold">Tarot de Marseille</span><br>Méthodes de <span class="emerald">tirage</span>
    </h1>
    <p class="subtitle">
      Le Tarot de Marseille est un outil puissant pour explorer l'inconscient. 
      Choisissez la méthode de tirage la plus adaptée à votre question et découvrez les messages des 22 arcanes majeurs.
    </p>
  </aside>

  <main class="hub-main">
    <div class="section-title">
      <div class="num">[ 01 ]</div>
      <h2>✦ Les 4 Tirages</h2>
      <p class="slate">Explorez votre destinée à travers ces 4 approches.</p>
    </div>

    <div class="mystere-grid">

      <!-- Carte 1 : 3 Cartes -->
      <div class="mystere-card" style="--card-accent-color: var(--gold); --hover-accent-color: var(--gold);">
        <div class="card-icon">🕒</div>
        <h3>TIRAGE À 3 CARTES</h3>
        <p>
          Passé, Présent, Futur. Une méthode simple et rapide pour obtenir une réponse directe à une question ou comprendre une évolution.
        </p>
        <a href="/tarologie/marseille/trois-cartes/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

      <!-- Carte 2 : En Croix -->
      <div class="mystere-card" style="--card-accent-color: var(--emerald); --hover-accent-color: var(--emerald);">
        <div class="card-icon">✚</div>
        <h3>TIRAGE EN CROIX</h3>
        <p>
          Le tirage de référence. 5 cartes pour peser le pour, le contre, comprendre les enjeux spirituels et connaître l'issue matérielle.
        </p>
        <a href="/tarologie/marseille/croix/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

      <!-- Carte 3 : En Ligne -->
      <div class="mystere-card" style="--card-accent-color: var(--violet); --hover-accent-color: var(--violet);">
        <div class="card-icon">📏</div>
        <h3>TIRAGE EN LIGNE</h3>
        <p>
          Une approche narrative et intuitive. Lisez les cartes de gauche à droite comme une histoire, en observant les dynamiques.
        </p>
        <a href="/tarologie/marseille/ligne/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

      <!-- Carte 4 : Astrologique -->
      <div class="mystere-card" style="--card-accent-color: var(--rose); --hover-accent-color: var(--rose);">
        <div class="card-icon">♈</div>
        <h3>TIRAGE ASTROLOGIQUE</h3>
        <p>
          Les 12 maisons. Un tirage approfondi pour faire un bilan global de votre vie sur l'année à venir, reliant tarot et astrologie.
        </p>
        <a href="/tarologie/marseille/astrologique/" class="btn-explore">Tirer les cartes ✦</a>
      </div>

    </div>
  </main>
</div>

</Layout>
