---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Plateforme des Mystères",
  "url": "https://plateforme-des-mysteres.com/",
  "description": "Explorez les sagesses ancestrales : numérologie cabalistique, tarologie, astrologie et oracles.",
  "inLanguage": "fr"
};
---

<Layout
  title="Plateforme des Mystères — Sagesses Ésotériques"
  description="Explorez les sagesses ancestrales : numérologie cabalistique, tarologie, astrologie et oracles. Chemin de vie, ticún, 22 archétypes. Sans pub, sans tracking."
  keywords="numérologie, cabalistique, tarologie, astrologie, oracles, ésotérisme, chemin de vie, ticún, Raúl Durán, archétypes, kabbale, Belline, Gé, runes, Yi King"
  canonicalPath=""
  jsonLd={jsonLd}
>

<!-- ═══════════ HERO ═══════════ -->
<section id="hero-landing">
  <div class="hero-badge">◈ Sagesses Ésotériques · Gratuit · Sans tracking</div>
  <h1>
    Décodez le langage<br>
    de votre <span class="gold">incarnation</span>
  </h1>
  <p class="hero-sub">
    Numérologie, tarologie, astrologie, oracles — des outils ancestraux<br>
    pour une connaissance de soi profonde. Calculez, tirez, explorez.
  </p>
  <div class="hero-cta-group">
    <a href="/numerologie/cabalistique/" class="hero-btn-primary">✦ Calculer mon Chemin de Vie</a>
    <a href="/tarologie/marseille/trois-cartes/" class="hero-btn-secondary">🃏 Tirer le Tarot</a>
    <a href="/numerologie/prenom/" class="hero-btn-secondary">Analyser mon Prénom</a>
  </div>
</section>

<!-- ═══════════ TIRAGE DU JOUR ═══════════ -->
<section id="tirage-jour">
  <a href="/tarologie/lenormand/quotidien/" class="tirage-jour-card">
    <div class="tirage-jour-text">
      <div class="tirage-jour-badge">✦ <span id="tirageJourDate"></span></div>
      <h2>Ta carte du jour</h2>
      <p>Une carte du Petit Lenormand, un conseil concret pour aujourd'hui.</p>
    </div>
    <span class="tirage-jour-cta">🔮 Tirer ma carte du jour</span>
  </a>
</section>

<!-- ═══════════ OUTILS RAPIDES ═══════════ -->
<section id="outils-rapides">
  <div class="section-title">
    <div class="num">[ CALCULATEURS & TIRAGES ]</div>
    <h2>✦ Outils Interactifs</h2>
    <p class="slate">Lancez un calcul ou un tirage directement — tout se passe dans votre navigateur, sans compte.</p>
  </div>

  <div class="tools-grid">

    <a href="/numerologie/cabalistique/" class="tool-card tool-num">
      <div class="tool-icon">🔢</div>
      <div class="tool-body">
        <h3>Chemin de Vie Cabalistique</h3>
        <p>Méthode Raúl Durán · 22 archétypes hébraïques · Ticún & don d'âme</p>
      </div>
      <span class="tool-cta">Calculer ✦</span>
    </a>

    <a href="/numerologie/prenom/" class="tool-card tool-num">
      <div class="tool-icon">✎</div>
      <div class="tool-body">
        <h3>Numérologie du Prénom</h3>
        <p>Nombre Actif · Leçons karmiques · Mémoires transgénérationnelles</p>
      </div>
      <span class="tool-cta">Analyser ✦</span>
    </a>

    <a href="/numerologie/pythagoricienne/" class="tool-card tool-num">
      <div class="tool-icon">π</div>
      <div class="tool-body">
        <h3>Numérologie Pythagoricienne</h3>
        <p>Chemin de vie · Expression · Âme · Personnalité · Les 5 nombres clés</p>
      </div>
      <span class="tool-cta">Calculer ✦</span>
    </a>

    <a href="/numerologie/chaldeenne/" class="tool-card tool-num">
      <div class="tool-icon">𒀭</div>
      <div class="tool-body">
        <h3>Numérologie Chaldéenne</h3>
        <p>Tradition babylonienne · Nombre de naissance · Nombre du nom</p>
      </div>
      <span class="tool-cta">Calculer ✦</span>
    </a>

    <a href="/tarologie/marseille/trois-cartes/" class="tool-card tool-tarot">
      <div class="tool-icon">🃏</div>
      <div class="tool-body">
        <h3>Tirage Tarot Marseille</h3>
        <p>3 cartes · Passé, Présent, Futur · 22 arcanes majeurs</p>
      </div>
      <span class="tool-cta">Tirer ✦</span>
    </a>

    <a href="/oracles/runes/trois-runes/" class="tool-card tool-oracle">
      <div class="tool-icon">ᚠ</div>
      <div class="tool-body">
        <h3>Tirage de Runes</h3>
        <p>Futhark Ancien · 3 runes · Sagesse nordique d'Odin</p>
      </div>
      <span class="tool-cta">Tirer ✦</span>
    </a>

    <a href="/oracles/yi-king/simple/" class="tool-card tool-oracle">
      <div class="tool-icon">☯</div>
      <div class="tool-body">
        <h3>Oracle Yi King</h3>
        <p>64 hexagrammes · Classique des mutations · Sagesse taoïste</p>
      </div>
      <span class="tool-cta">Consulter ✦</span>
    </a>

    <a href="/oracles/triade/trois-cartes/" class="tool-card tool-oracle">
      <div class="tool-icon">🔮</div>
      <div class="tool-body">
        <h3>Oracle Triade</h3>
        <p>Tirage 3 cartes · Corps, Âme, Esprit · Lecture intuitive</p>
      </div>
      <span class="tool-cta">Tirer ✦</span>
    </a>

  </div>
</section>

<!-- ═══════════ RAPPORT D'INCARNATION ═══════════ -->
<section id="rapport-premium" class="reveal">
  <div class="rapport-premium-inner">

    <div class="rapport-premium-content">
      <div class="num">[ RAPPORT PDF ]</div>
      <h2 class="rapport-h2">✦ Rapport d'Incarnation</h2>
      <p class="rapport-intro">Un document de <strong>20+ pages</strong>, entièrement personnalisé à partir de votre prénom, nom de naissance et date de naissance. Livré par email en moins d'une minute.</p>

      <ul class="rapport-features">
        <li><span class="rf-bullet">✦</span> Numérologie complète — chemin de vie, expression, âme, personnalité</li>
        <li><span class="rf-bullet">✦</span> Carré Lo Shu & séquences à développer (exemples concrets)</li>
        <li><span class="rf-bullet">✦</span> Oracle Lenormand — Carré de 9, lignes, colonnes, diagonales</li>
        <li><span class="rf-bullet">✦</span> Plans personnel, professionnel et relationnel</li>
        <li><span class="rf-bullet">✦</span> Tarot de Marseille · Astrologie · Tikoun kabbalistique</li>
        <li><span class="rf-bullet">✦</span> Livraison email instantanée · PDF haute qualité</li>
      </ul>

      <div class="rapport-cta-row">
        <a href="/rapport/" class="rapport-cta-main">✦ Obtenir mon rapport — 10 €</a>
        <a href="https://mystereplateform.gumroad.com/l/rapportdincarnation" class="rapport-cta-secondary" target="_blank" rel="noopener">Acheter une clé →</a>
      </div>
      <p class="rapport-note">Clé de licence requise · Disponible sur la boutique · Utilisable 3 fois</p>
    </div>

    <div class="rapport-premium-visual">
      <div class="rapport-pdf-mock">
        <div class="pdf-mock-header">
          <span class="pdf-mock-logo">◈</span>
          <span>Plateforme des Mystères</span>
        </div>
        <div class="pdf-mock-title">Rapport<br>d'Incarnation</div>
        <div class="pdf-mock-name">Votre Prénom Nom</div>
        <div class="pdf-mock-disciplines">
          <span>Numérologie</span>
          <span>Tarot</span>
          <span>Astrologie</span>
          <span>Tikoun</span>
        </div>
        <div class="pdf-mock-sections">
          <div class="pdf-section-line">01 — Profil Numérologique</div>
          <div class="pdf-section-line">05 — Carré Lo Shu</div>
          <div class="pdf-section-line">09 — Oracle Lenormand</div>
          <div class="pdf-section-line">14 — Tarot de Marseille</div>
          <div class="pdf-section-line">18 — Astrologie & Tikoun</div>
          <div class="pdf-section-line">21 — Synthèse & Conseils</div>
        </div>
        <div class="pdf-mock-footer">20+ pages · PDF personnalisé</div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════ PORTAILS — 4 DISCIPLINES ═══════════ -->
<section id="portails" class="reveal">
  <div class="section-title">
    <div class="num">[ EXPLOREZ ]</div>
    <h2>✦ Les Quatre Voies</h2>
    <p class="slate">Chaque discipline est une porte vers la connaissance de soi.</p>
  </div>

  <div class="disciplines-grid reveal">

    <!-- Carte 1 : Numérologie -->
    <div class="discipline-card card-numerologie">
      <div class="disc-icon">🔢</div>
      <h3>Numérologie</h3>
      <p class="disc-desc">Quatre traditions pour décoder les vibrations de votre identité : cabalistique, pythagoricienne, chaldéenne et chinoise.</p>
      <div class="cta-group">
        <a href="/numerologie/" class="disc-cta">Les 4 Étoiles ✦</a>
      </div>
    </div>

    <!-- Carte 2 : Tarologie -->
    <div class="discipline-card card-tarologie">
      <div class="disc-icon">🃏</div>
      <h3>Tarologie</h3>
      <p class="disc-desc">Les 22 arcanes majeurs du Tarot de Marseille. Symbolisme, interprétation et tirages.</p>
      <div class="cta-group">
        <a href="/tarologie/" class="disc-cta">Les 4 Traditions ✦</a>
      </div>
    </div>

    <!-- Carte 3 : Astrologie -->
    <div class="discipline-card card-astrologie">
      <div class="disc-icon">⭐</div>
      <h3>Astrologie</h3>
      <p class="disc-desc">Les astres et votre thème natal. Signes, maisons, aspects et transits planétaires.</p>
      <div class="cta-group">
        <a href="/astrologie/" class="disc-cta">Les 4 Systèmes ✦</a>
      </div>
    </div>

    <!-- Carte 4 : Oracles -->
    <div class="discipline-card card-oracles">
      <div class="disc-icon">🔮</div>
      <h3>Oracles</h3>
      <p class="disc-desc">Belline, Gé, Runes, Yi King. Des sagesses divinatoires pour éclairer votre chemin.</p>
      <div class="cta-group">
        <a href="/oracles/" class="disc-cta">Les 4 Oracles ✦</a>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════ DERNIERS ARTICLES ═══════════ -->
<section id="articles" class="reveal">
  <div class="section-title">
    <div class="num">[ BLOG ]</div>
    <h2>✦ Derniers Articles</h2>
    <p class="slate">Réflexions, analyses et explorations ésotériques.</p>
  </div>

  <div class="articles-grid">

    <a href="/blog/tarot-marseille/" class="article-card">
      <div class="article-meta">Tarot · Marseille · 12 min</div>
      <h3>Tarot de Marseille : histoire, structure et sagesse médiévale</h3>
      <p>Le plus ancien tarot divinatoire occidental : origines italiennes, 3 septénaires, 22 arcanes majeurs, 4 suites.</p>
    </a>

    <a href="/blog/astrologie-tropicale/" class="article-card">
      <div class="article-meta">Astrologie · Tropicale · 12 min</div>
      <h3>Astrologie tropicale : fondements, symboles et mécanique céleste</h3>
      <p>Bélier à Poissons, Soleil à Pluton, Maison I à XII : les trois piliers de l'astrologie occidentale expliqués.</p>
    </a>

    <a href="/blog/runes-futhark/" class="article-card">
      <div class="article-meta">Oracles · Runes · 12 min</div>
      <h3>Les Runes nordiques : le Futhark sacré d'Odin</h3>
      <p>24 signes gravés sur bois, pierre ou os. Mythes d'Odin, sagesse du Nord et divination runique au quotidien.</p>
    </a>

    <a href="/blog/methode-raul-duran/" class="article-card">
      <div class="article-meta">Numérologie · Méthode · 7 min</div>
      <h3>La méthode Raúl Durán expliquée</h3>
      <p>Le calcul pas à pas : réduction, chemin de vie, ticún. Avec l'exemple concret et le tableau complet des 22 archétypes.</p>
    </a>

    <a href="/blog/nombres-maitres/" class="article-card">
      <div class="article-meta">Numérologie · Nombres Maîtres · 11 min</div>
      <h3>Les nombres maîtres 11, 22, 33 : potentiel et fardeau</h3>
      <p>Pourquoi certaines âmes naissent avec un double chiffre ? Contrats exigeants, guide complet.</p>
    </a>

    <a href="/blog/astro-numerologie/" class="article-card">
      <div class="article-meta">Ponts · Astrologie · 12 min</div>
      <h3>Astrologie et numérologie : planètes et nombres</h3>
      <p>Saturne = 8, Jupiter = 3, Vénus = 6. Les correspondances anciennes pour une lecture ésotérique complète.</p>
    </a>

  </div>

  <div style="text-align:center;margin-top:3rem;">
    <a href="/blog/" class="disc-cta" style="display:inline-block;max-width:280px;">Voir tous les articles →</a>
  </div>
</section>

  <p slot="sources" style="color:#64748b;font-size:0.75rem;margin-bottom:0.8rem;">
    Sources : <a href="https://www.youtube.com/watch?v=eVfgONpEoDo" target="_blank">Podcast Lo Grande — Raúl Durán</a>
  </p>

</Layout>

<style is:global>

/* ═══════════ HERO LANDING ═══════════ */
#hero-landing {
  text-align: center;
  padding: 6rem 1.5rem 4rem;
  position: relative;
}
#hero-landing::before {
  content: '';
  position: absolute;
  top: -10%;
  left: 50%;
  transform: translateX(-50%);
  width: 600px;
  height: 400px;
  background: radial-gradient(ellipse, rgba(223,178,108,0.07) 0%, transparent 70%);
  pointer-events: none;
}
.hero-badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  color: var(--gold-text);
  text-transform: uppercase;
  border: 1px solid rgba(223,178,108,0.25);
  border-radius: 999px;
  padding: 0.35rem 1rem;
  margin-bottom: 2rem;
}
#hero-landing h1 {
  font-family: var(--font-sans);
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 1.5rem;
  color: var(--text);
}
.hero-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.8;
  max-width: 560px;
  margin: 0 auto 2.5rem;
}
.hero-cta-group {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.hero-btn-primary {
  display: inline-block;
  padding: 0.85rem 2rem;
  background: var(--gold);
  color: var(--bg-deep);
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 0.95rem;
  border-radius: 12px;
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: all 0.25s ease;
}
.hero-btn-primary:hover {
  filter: brightness(1.1);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(223,178,108,0.35);
}
.hero-btn-secondary {
  display: inline-block;
  padding: 0.85rem 1.5rem;
  background: transparent;
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 0.9rem;
  border: 1px solid var(--border);
  border-radius: 12px;
  text-decoration: none;
  transition: all 0.25s ease;
}
.hero-btn-secondary:hover {
  border-color: var(--gold-text);
  color: var(--gold-text);
  transform: translateY(-2px);
}

/* ═══════════ RAPPORT HERO TEASER ═══════════ */
.rapport-hero-teaser {
  display: inline-flex;
  align-items: center;
  gap: 0.85rem;
  margin-top: 2rem;
  padding: 0.6rem 1.25rem;
  background: rgba(223,178,108,0.06);
  border: 1px solid rgba(223,178,108,0.2);
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.25s ease;
  max-width: min(600px, 100%);
  flex-wrap: nowrap;
}
.rapport-hero-teaser:hover {
  background: rgba(223,178,108,0.1);
  border-color: rgba(223,178,108,0.45);
  transform: translateY(-1px);
}
.rapport-teaser-pill {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  color: var(--bg-deep);
  background: var(--gold);
  border-radius: 999px;
  padding: 0.2rem 0.65rem;
  font-weight: 700;
  flex-shrink: 0;
  white-space: nowrap;
}
.rapport-teaser-text {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.3;
}
.rapport-teaser-arrow {
  color: var(--gold-text);
  font-size: 0.9rem;
  flex-shrink: 0;
}

/* ═══════════ RAPPORT PREMIUM SECTION ═══════════ */
#rapport-premium {
  padding: 5rem 1.5rem;
  position: relative;
}
#rapport-premium::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 65% 50%, rgba(223,178,108,0.05) 0%, transparent 60%);
  pointer-events: none;
}
.rapport-premium-inner {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 4rem;
  max-width: 1200px;
  margin: 0 auto;
  align-items: center;
}
.rapport-h2 {
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 700;
  color: var(--gold-text);
  margin-bottom: 1.25rem;
  letter-spacing: -0.02em;
}
.rapport-intro {
  font-size: 1rem;
  color: var(--text-muted);
  line-height: 1.75;
  margin-bottom: 2rem;
  max-width: 520px;
}
.rapport-intro strong { color: var(--text); }
.rapport-features {
  list-style: none;
  padding: 0;
  margin: 0 0 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}
.rapport-features li {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  font-size: 0.9rem;
  color: var(--text);
  line-height: 1.5;
}
.rf-bullet {
  color: var(--gold-text);
  font-size: 0.7rem;
  margin-top: 0.3rem;
  flex-shrink: 0;
}
.rapport-cta-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.85rem;
}
.rapport-cta-main {
  display: inline-block;
  padding: 0.9rem 2.25rem;
  background: var(--gold);
  color: var(--bg-deep);
  font-weight: 700;
  font-size: 0.95rem;
  border-radius: 12px;
  text-decoration: none;
  transition: all 0.25s ease;
  letter-spacing: 0.02em;
}
.rapport-cta-main:hover {
  filter: brightness(1.1);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(223,178,108,0.35);
}
.rapport-cta-secondary {
  font-size: 0.88rem;
  color: var(--text-muted);
  text-decoration: none;
  font-family: var(--font-mono);
  transition: color 0.2s;
}
.rapport-cta-secondary:hover { color: var(--gold-text); }
.rapport-note {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
  letter-spacing: 0.02em;
}
/* PDF Mockup */
.rapport-pdf-mock {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.75rem;
  position: relative;
  overflow: hidden;
}
.rapport-pdf-mock::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--gold), rgba(223,178,108,0.2));
}
.pdf-mock-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.68rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
  margin-bottom: 1.5rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.pdf-mock-logo { color: var(--gold); font-size: 0.85rem; }
.pdf-mock-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--gold-text);
  line-height: 1.2;
  margin-bottom: 0.6rem;
  letter-spacing: -0.02em;
}
.pdf-mock-name {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
  margin-bottom: 1.1rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.pdf-mock-disciplines {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-bottom: 1.5rem;
}
.pdf-mock-disciplines span {
  font-size: 0.63rem;
  font-family: var(--font-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--gold-text);
  border: 1px solid rgba(223,178,108,0.3);
  border-radius: 999px;
  padding: 0.18rem 0.55rem;
}
.pdf-mock-sections {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 1.25rem;
}
.pdf-section-line {
  font-size: 0.74rem;
  font-family: var(--font-mono);
  color: var(--text-muted);
  padding: 0.35rem 0.65rem;
  background: rgba(255,255,255,0.02);
  border-left: 2px solid rgba(223,178,108,0.25);
  border-radius: 0 4px 4px 0;
  letter-spacing: 0.02em;
}
.pdf-mock-footer {
  text-align: center;
  font-size: 0.67rem;
  font-family: var(--font-mono);
  color: var(--text-dim);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding-top: 1.1rem;
  border-top: 1px solid var(--border);
}
@media (max-width: 900px) {
  .rapport-premium-inner {
    grid-template-columns: 1fr;
