---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Numérologie Pythagoricienne — Calcul et interprétation",
  "url": "https://mysteres.fr/numerologie/pythagoricienne/",
  "description": "Calcule ton chemin de vie, nombre d'expression, désir de l'âme et personnalité selon la méthode pythagoricienne. 5 nombres fondamentaux, 12 vibrations, interprétation personnalisée.",
  "inLanguage": "fr",
  "about": {
    "@type": "Thing",
    "name": "Numérologie Pythagoricienne"
  }
};
---

<Layout
  title="Numérologie Pythagoricienne — Calcul et interprétation"
  description="Calcule ton chemin de vie, nombre d'expression, désir de l'âme et personnalité selon la méthode pythagoricienne. 5 nombres fondamentaux, 12 vibrations, interprétation personnalisée. Gratuit."
  keywords="numérologie pythagoricienne, Pythagore, chemin de vie, nombre d'expression, désir de l'âme, personnalité, année personnelle, nombres maîtres, calcul numérologie"
  canonicalPath="numerologie/pythagoricienne/"
  jsonLd={jsonLd}
  scripts={["/assets/js/pythagoricien.js"]}
  breadcrumb={[
    { name: "Accueil", item: "https://mysteres.fr/" },
    { name: "Numérologie", item: "https://mysteres.fr/numerologie/" },
    { name: "Pythagoricienne", item: "https://mysteres.fr/numerologie/pythagoricienne/" }
  ]}
  section="numerologie"
>

<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/numerologie/" style="color:var(--cyan);">Numérologie</a> &rsaquo;
  <span style="color:var(--text);">Pythagoricienne</span>
</nav>

<!-- ═══════════ HERO ═══════════ -->
<section id="hero">
  <h1>
    <span class="pulse"></span>
    Les nombres sont la <span class="gold">clé</span><br>de l'<span class="emerald">harmonie universelle</span>
  </h1>
  <p class="subtitle">
    Découvre ce que ta date de naissance et ton nom de naissance révèlent sur ton chemin de vie, tes dons, tes motivations profondes et l'image que tu projettes — selon la méthode pythagoricienne telle que codifiée par Hans Decoz et Matthew Goodwin.
  </p>
  <a href="#calculateur" class="cta">✦ Révéler mes 5 nombres</a>
  <p class="quote">
    « Les nombres dirigent les formes et les idées, et sont à la racine des dieux et des démons. »
    <br><span class="gold">— Pythagore</span>
  </p>
</section>

<!-- ═══════════ [01] CALCULATEUR ═══════════ -->
<section id="calculateur">
  <div class="section-title">
    <div class="num">[ 01 ]</div>
    <h2>✦ Calculateur Pythagoricien</h2>
    <p class="slate">Entre ta date de naissance complète et ton nom officiel à la naissance pour obtenir tes 5 nombres fondamentaux.</p>
  </div>

  <div style="max-width:640px;margin:0 auto 1.5rem;text-align:center;">
    <p class="pyth-intro-text">
      La méthode pythagoricienne utilise à la fois ta
      <strong class="pyth-label-emerald">date de naissance</strong> (pour le chemin de vie)
      et ton <strong class="pyth-label-violet">prénom et nom à la naissance</strong>
      (pour les 4 autres nombres).
    </p>
    <p class="pyth-intro-sub">
      Utilise le nom inscrit sur ton acte de naissance — y compris les prénoms composés.
    </p>
  </div>

  <form class="pyth-form" id="pyth-form" onsubmit="return false;">
    <div class="pyth-form-group">
      <label class="pyth-label">Date de naissance</label>
      <div class="pyth-date-row">
        <div class="pyth-field">
          <input type="number" id="pyth-jour" class="pyth-input" min="1" max="31" placeholder="JJ" aria-label="Jour de naissance" inputmode="numeric">
          <span class="pyth-field-label">Jour</span>
        </div>
        <div class="pyth-field">
          <input type="number" id="pyth-mois" class="pyth-input" min="1" max="12" placeholder="MM" aria-label="Mois de naissance" inputmode="numeric">
          <span class="pyth-field-label">Mois</span>
        </div>
        <div class="pyth-field pyth-field--wide">
          <input type="number" id="pyth-annee" class="pyth-input" min="1900" max="2100" placeholder="AAAA" aria-label="Année de naissance" inputmode="numeric">
          <span class="pyth-field-label">Année</span>
        </div>
      </div>
    </div>
    <div class="pyth-form-group">
      <label class="pyth-label">Prénom(s) à la naissance</label>
      <input type="text" id="pyth-prenom" class="pyth-input pyth-input--full" placeholder="ex. Marie Claire" aria-label="Prénom ou prénoms à la naissance" autocomplete="given-name">
    </div>
    <div class="pyth-form-group">
      <label class="pyth-label">Nom de famille à la naissance</label>
      <input type="text" id="pyth-nom" class="pyth-input pyth-input--full" placeholder="ex. Dupont" aria-label="Nom de famille à la naissance" autocomplete="family-name">
    </div>
    <div class="pyth-form-actions">
      <button type="button" id="pyth-exemple" class="pyth-btn-example">Essayer avec un exemple</button>
      <button type="submit" class="pyth-btn-calc">Révéler mes 5 nombres ✦</button>
    </div>
  </form>

  <!-- ─── RÉSULTATS ─── -->
  <div id="pythResultats" hidden>
    <div class="pyth-section-sep"></div>

    <!-- Formule de calcul -->
    <div class="pyth-result-block">
      <h3 class="pyth-result-title"><span class="cf-gold">◈</span> La formule de tes nombres</h3>
      <div id="pythFormule"></div>
    </div>

    <!-- Grille des 4 nombres fondamentaux -->
    <div class="pyth-result-block">
      <h3 class="pyth-result-title"><span class="cf-gold">◈</span> Tes 4 nombres fondamentaux</h3>
      <div class="pyth-core-grid" id="pythCoreGrid"></div>
    </div>

    <!-- Année personnelle -->
    <div class="pyth-result-block">
      <h3 class="pyth-result-title"><span class="cf-gold">◈</span> Ton année personnelle</h3>
      <div id="pythAnneePerso"></div>
    </div>

    <!-- Détails étendus -->
    <div class="pyth-result-block">
      <h3 class="pyth-result-title"><span class="cf-gold">◈</span> Interprétation détaillée</h3>
      <div class="pyth-details" id="pythDetails"></div>
    </div>
  </div>
</section>

<!-- ═══════════ [02] LES 12 VIBRATIONS ═══════════ -->
<section id="vibrations">
  <div class="section-title">
    <div class="num">[ 02 ]</div>
    <h2>✦ Les 12 Vibrations</h2>
    <p class="slate">Les 9 nombres fondamentaux et les 3 nombres maîtres (11, 22, 33). Clique pour retourner la carte et voir l'ombre.</p>
  </div>
  <div class="grid" id="pythNombresGrid"></div>
  <p style="text-align:center;font-size:0.8rem;color:var(--text-muted);margin-top:1rem;">
    ✦ Survoler une carte retournée affiche l'interprétation complète
  </p>
</section>

<!-- ═══════════ [03] LA MÉTHODE ═══════════ -->
<section id="methode">
  <div class="section-title">
    <div class="num">[ 03 ]</div>
    <h2>✦ La Méthode Pythagoricienne</h2>
    <p class="slate">Comment sont calculés tes 5 nombres — et pourquoi cette méthode est différente des autres traditions.</p>
  </div>

  <!-- Table des équivalences -->
  <div class="pyth-table-wrapper">
    <h3 class="pyth-table-title">Table des équivalences A–Z</h3>
    <div class="pyth-table">
      <div class="pyth-table-row pyth-table-header">
        <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span>
      </div>
      <div class="pyth-table-row">
        <span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span><span>G</span><span>H</span><span>I</span>
      </div>
      <div class="pyth-table-row">
        <span>J</span><span>K</span><span>L</span><span>M</span><span>N</span><span>O</span><span>P</span><span>Q</span><span>R</span>
      </div>
      <div class="pyth-table-row">
        <span>S</span><span>T</span><span>U</span><span>V</span><span>W</span><span>X</span><span>Y</span><span>Z</span><span>—</span>
      </div>
    </div>
    <p class="pyth-table-note">Séquence continue A=1 à Z=8 (cycle par 9) — Y compte 7, Z compte 8.</p>
  </div>

  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <h3>Chemin de Vie</h3>
      <p>Chaque composant de la date (jour, mois, année) est réduit séparément, puis les trois résultats sont sommés et réduits. Les nombres maîtres 11, 22 et 33 ne sont jamais réduits davantage.</p>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <h3>Nombre d'Expression</h3>
      <p>Chaque lettre du prénom complet et du nom de naissance est convertie selon la table pythagoricienne, la somme de chaque mot est réduite, puis les partiels sont sommés et réduits.</p>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <h3>Désir de l'Âme</h3>
      <p>Seules les <strong>voyelles</strong> (A, E, I, O, U et Y lorsqu'aucune voyelle adjacente n'est présente) contribuent à ce nombre — il révèle les motivations profondes et les désirs intérieurs.</p>
    </div>
    <div class="step">
      <div class="step-num">4</div>
      <h3>Nombre de Personnalité</h3>
      <p>Seules les <strong>consonnes</strong> (toutes les lettres hors voyelles) entrent dans ce calcul — il reflète l'image extérieure, la façon dont les autres perçoivent ta présence dans le monde.</p>
    </div>
    <div class="step">
      <div class="step-num">5</div>
      <h3>Année Personnelle</h3>
      <p>Jour + Mois de naissance + Année civile courante, réduits et sommés. Le cycle personnel de 9 ans révèle les thèmes et les opportunités de l'année en cours.</p>
    </div>
  </div>

  <!-- Différences avec d'autres méthodes -->
  <div class="pyth-diff-box">
    <h4 class="pyth-diff-title">En quoi diffère-t-elle des autres méthodes ?</h4>
    <div class="pyth-diff-grid">
      <div class="pyth-diff-item">
        <span class="pyth-diff-lbl cf-emerald">Pythagoricienne</span>
        <span>Table A=1 → Z=8 séquentielle, 5 nombres fondamentaux, Y = voyelle conditionnelle, nombres maîtres 11/22/33</span>
      </div>
      <div class="pyth-diff-item">
        <span class="pyth-diff-lbl cf-violet">Cabalistique</span>
        <span>Table hébraïque (Raúl Durán), 22 archétypes, chemin de vie + ticún, pas de calcul sur le nom</span>
      </div>
      <div class="pyth-diff-item">
        <span class="pyth-diff-lbl cf-gold">Chaldéenne</span>
        <span>Table 1–8 seulement (le 9 est sacré, non attribué), importance des vibrations sonores</span>
      </div>
    </div>
  </div>
</section>

  <p slot="sources" style="color:#64748b;font-size:0.75rem;margin-bottom:0.8rem;">
    Sources : <a href="https://www.worldnumerology.com" target="_blank" rel="noopener">Hans Decoz — WorldNumerology</a> ·
    Matthew Goodwin, <em>Numerology: The Complete Guide</em> ·
    <a href="https://www.numerologist.com" target="_blank" rel="noopener">Numerologist.com</a> ·
    SeventhLifePath.com · Mindbodygreen Numerology Guide
  </p>

</Layout>

<style is:global>
  /* ═══════════ PYTHAGORICIENNE — styles globaux ═══════════ */

  /* ─── Utilitaires couleur ─── */
  .cf-rose     { color: var(--rose) !important; }
  .cf-bg-rose  { background: rgba(251,129,149,0.12) !important; }

  /* ─── Intro sous le titre ─── */
  .pyth-intro-text {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .pyth-intro-sub {
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-top: 0.5rem;
  }
  .pyth-label-emerald { color: var(--emerald); }
  .pyth-label-violet  { color: var(--violet); }

  /* ─── Formulaire ─── */
  .pyth-form {
    max-width: 620px;
    margin: 0 auto;
    background: linear-gradient(150deg, rgba(18,25,42,0.90) 0%, rgba(10,13,23,0.95) 100%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 2rem;
    backdrop-filter: blur(12px);
  }
  .pyth-form-group { margin-bottom: 1.25rem; }
  .pyth-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  .pyth-date-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .pyth-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }
  .pyth-field--wide { flex: 1.5; }
  .pyth-field-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-align: center;
  }
  .pyth-input {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text);
    text-align: center;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    -moz-appearance: textfield;
  }
  .pyth-input::-webkit-outer-spin-button,
  .pyth-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pyth-input--full { text-align: left; }
  .pyth-input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(223,178,108,0.15);
  }
  .pyth-form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .pyth-btn-example {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--text-muted);
    padding: 0.85rem 1rem;
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    transition: border-color 0.2s, color 0.2s;
    min-width: 140px;
  }
  .pyth-btn-example:hover { border-color: var(--gold); color: var(--gold); }
  .pyth-btn-calc {
    flex: 2;
    background: linear-gradient(135deg, var(--gold), #b8872a);
    border: none;
    color: #0a0f1c;
    padding: 0.9rem 1.5rem;
    border-radius: 10px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: opacity 0.2s, transform 0.2s;
    min-width: 200px;
  }
  .pyth-btn-calc:hover { opacity: 0.92; transform: translateY(-1px); }

  /* ─── Séparateur résultats ─── */
  .pyth-section-sep {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(223,178,108,0.3), transparent);
    margin: 2.5rem 0;
  }

  /* ─── Blocs de résultats ─── */
  .pyth-result-block { margin-bottom: 2.5rem; }
  .pyth-result-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    font-weight: 400;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ─── Formule de calcul ─── */
  .pyth-formule {
    background: linear-gradient(150deg, rgba(18,25,42,0.85) 0%, rgba(10,13,23,0.92) 100%);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    padding: 1.5rem;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .pf-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .pf-lbl {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    min-width: 120px;
    flex-shrink: 0;
  }
  .pf-calc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    flex: 1;
  }
  .pf-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: 8px;
    padding: 0.25rem 0.6rem;
    min-width: 40px;
  }
  .pf-wname {
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.5);
    line-height: 1.2;
  }
  .pf-wval { font-size: 1rem; font-weight: 700; line-height: 1.2; }
  .pf-op   { color: var(--text-muted); font-size: 0.85rem; }
  .pf-sum  { font-size: 1rem; font-weight: 600; color: var(--slate); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 6px; padding: 0.15rem 0.45rem; }
  .pf-arrow { color: var(--text-muted); font-size: 0.9rem; }
  .pf-res  { font-size: 0.92rem; }

  /* Bg colorés pour pf-box */
  .cf-bg-emerald { background: rgba(61,211,153,0.1); }
  .cf-bg-violet  { background: rgba(183,139,250,0.1); }
  .cf-bg-cyan    { background: rgba(59,211,238,0.1); }

  /* ─── Grille des 4 nombres fondamentaux ─── */
  .pyth-core-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .core-card {
    background: linear-gradient(150deg, rgba(18,25,42,0.92) 0%, rgba(10,13,23,0.97) 100%);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    padding: 1.25rem 1rem;
    text-align: center;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.30);
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s cubic-bezier(0.16,1,0.3,1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .cp-chemin       { border-top: 2px solid var(--emerald); }
  .cp-expression   { border-top: 2px solid var(--violet); }
  .cp-ame          { border-top: 2px solid var(--rose); }
  .cp-personnalite { border-top: 2px solid var(--cyan); }
  .cp-chemin:hover       { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.40), 0 0 20px -8px var(--emerald); }
  .cp-expression:hover   { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.40), 0 0 20px -8px var(--violet); }
  .cp-ame:hover          { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.40), 0 0 20px -8px var(--rose); }
  .cp-personnalite:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.40), 0 0 20px -8px var(--cyan); }
  .core-num {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    position: relative;
  }
  .maitre-sup {
    font-size: 0.65rem;
    vertical-align: super;
    letter-spacing: 0;
    color: var(--gold);
    margin-left: 2px;
  }
  .core-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }
  .core-titre { font-size: 0.82rem; font-weight: 600; color: var(--text-dim); margin-top: 0.2rem; }
  .core-note  { font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; margin-top: 0.2rem; }

  /* ─── Année personnelle ─── */
  .pa-card {
    background: linear-gradient(150deg, rgba(18,25,42,0.90) 0%, rgba(10,13,23,0.96) 100%);
    border: 1px solid rgba(223,178,108,0.15);
    border-left: 3px solid var(--gold);
    border-radius: 14px;
    padding: 1.5rem 2rem;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    backdrop-filter: blur(10px);
  }
  .pa-left { text-align: center; flex-shrink: 0; }
  .pa-num {
    font-family: var(--font-mono);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
  }
  .pa-year-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }
  .pa-right { flex: 1; }
  .pa-theme {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .pa-mot { font-weight: 400; color: var(--text-dim); }
  .pa-conseil {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.75;
    margin: 0;
  }

  /* ─── Cartes de détail ─── */
  .pyth-details { display: flex; flex-direction: column; gap: 1.5rem; }
  .pd-card {
    background: linear-gradient(150deg, rgba(18,25,42,0.90) 0%, rgba(10,13,23,0.96) 100%);
