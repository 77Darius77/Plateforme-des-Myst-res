---
import Layout from '../../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Calculateur de Numérologie — Les 4 écoles",
  "url": "https://plateforme-des-mysteres.com/numerologie/calculateur/",
  "description": "Calculateur universel de numérologie. Choisissez entre les 4 écoles pour découvrir vos nombres sacrés.",
  "inLanguage": "fr",
  "about": {
    "@type": "Thing",
    "name": "Calculateur de Numérologie"
  }
};
---

<Layout
  title="Calculateur de Numérologie — Les 4 écoles"
  description="Calculateur universel de numérologie : choisissez entre les 4 écoles (cabalistique, pythagoricienne, chaldéenne, chinoise). Gratuit, sans tracking."
  keywords="calculateur numérologie, calcul numérologie, écoles de numérologie, cabalistique, pythagoricienne, chaldéenne, chinoise, chemin de vie"
  canonicalPath="numerologie/calculateur/"
  jsonLd={jsonLd}
  breadcrumb={[
    { name: "Accueil", item: "https://plateforme-des-mysteres.com/" },
    { name: "Numérologie", item: "https://plateforme-des-mysteres.com/numerologie/" },
    { name: "Calculateur", item: "https://plateforme-des-mysteres.com/numerologie/calculateur/" }
  ]}
  section="numerologie"
>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Comment calculer votre chemin de vie numérologique",
  "description": "Entrez votre date de naissance pour obtenir votre nombre de chemin de vie et son interprétation.",
  "step": [
    { "@type": "HowToStep", "name": "Entrer la date", "text": "Saisissez votre date de naissance complète (jour, mois, année)." },
    { "@type": "HowToStep", "name": "Calculer", "text": "Cliquez sur Calculer pour obtenir votre nombre de chemin de vie." },
    { "@type": "HowToStep", "name": "Lire l'interprétation", "text": "Découvrez la signification de votre nombre selon les traditions numérologique." }
  ]
})} />

<!-- ═══════════ BANNIÈRE ═══════════ -->
<!-- ═══════════ FIL D'ARIANE ═══════════ -->
<nav class="breadcrumb" aria-label="Fil d'Ariane" style="padding:0.8rem 1.5rem;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);max-width:1200px;margin:0 auto;">
  <a href="/" style="color:var(--cyan);">Accueil</a> &rsaquo;
  <a href="/numerologie/" style="color:var(--cyan);">Numérologie</a> &rsaquo;
  <span style="color:var(--text);">Calculateur</span>
</nav>

<section id="hero">
  <h1>
    <span class="pulse"></span>
    🔢 <span class="gold">Calculateur Universel</span><br>Calculez votre <span class="emerald">numérologie</span>
  </h1>
  <p class="subtitle">
    Un calculateur qui permettra de choisir entre les 4 écoles de numérologie
    pour explorer les différentes facettes de votre être.
  </p>
  <p class="quote">
    « Qui connaît les nombres connaît les dieux. »
    <br><span class="gold">— Sagesse antique</span>
  </p>
</section>

<!-- ═══════════ CONTENU ═══════════ -->
<section id="contenu">
  <div class="section-title">
    <div class="num">[ 01 ]</div>
    <h2>✦ En cours de création</h2>
    <p class="slate">Cette section est en cours de création.</p>
  </div>

  <div style="max-width:700px;margin:2rem auto;background:#1e293b;border:1px solid #334155;border-radius:12px;padding:2.5rem;text-align:center;">
    <div style="font-size:3rem;margin-bottom:1rem;">✦</div>
    <p style="color:#cbd5e1;font-size:1.1rem;line-height:1.8;">
      Un calculateur universel qui permettra de choisir entre les 4 écoles de numérologie. En attendant, utilisez notre calculateur cabalistique !
    </p>
    <div style="margin-top:2rem;display:flex;flex-direction:column;gap:1rem;align-items:center;">
      <a href="/numerologie/cabalistique/" class="calc-cta-primary" style="display:inline-block;background:#fbbf24;color:#0f172a;font-family:var(--font-mono);font-size:0.9rem;padding:0.8rem 2rem;border-radius:8px;text-decoration:none;font-weight:700;transition:all 0.3s;">Essayer le calculateur cabalistique ✦</a>
      <a href="/numerologie/" class="calc-cta-secondary" style="display:inline-block;background:#334155;color:#94a3b8;font-family:var(--font-mono);font-size:0.85rem;padding:0.6rem 1.4rem;border-radius:8px;text-decoration:none;transition:all 0.3s;">← Retour à la numérologie</a>
    </div>
  </div>
</section>

  <p slot="sources" style="color:#64748b;font-size:0.75rem;margin-bottom:0.8rem;">
    Sources : Numérologie cabalistique, pythagoricienne, chaldéenne et chinoise
  </p>

<style>
  /* Remplace les gestionnaires onmouseover/onmouseout inline (CSP script-src). */
  .calc-cta-primary:hover { background: #f59e0b; }
  .calc-cta-secondary:hover { background: #475569; color: #cbd5e1; }
</style>
</Layout>
