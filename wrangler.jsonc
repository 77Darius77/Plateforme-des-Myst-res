{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plateforme-des-mysteres",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Le Worker passe en premier pour les pages HTML et /api/* (en-têtes de
    // sécurité, CSP). Les fichiers statiques versionnés sont servis directement.
    "run_worker_first": ["/*", "!/assets/*", "!/_astro/*", "!/images/*", "!/js/*"]
  },

  // Polices TTF (PDF) importées comme données binaires
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],

  // Limite de débit par IP (10 ou 60 secondes uniquement)
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
  ]
}
